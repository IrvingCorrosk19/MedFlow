@model MedFlow.Web.Controllers.WorkflowFormModel
@{
    var triggerEvents = ViewBag.TriggerEvents as IReadOnlyList<string> ?? [];
}
<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="Name">Nombre</label>
                    <input asp-for="Name" class="form-control" required />
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="Code">Código</label>
                    <input asp-for="Code" class="form-control" />
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Description">Descripción</label>
                <input asp-for="Description" class="form-control" />
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="TriggerEvent">Evento disparador</label>
                    <select asp-for="TriggerEvent" class="form-control" required>
                        @foreach (var e in triggerEvents)
                        {
                            <option value="@e">@e</option>
                        }
                    </select>
                </div>
                <div class="form-group col-md-6">
                    <div class="form-check pt-4">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Workflow activo</label>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="WebhookUrl">URL del Webhook (n8n)</label>
                <input asp-for="WebhookUrl" class="form-control" required />
            </div>
            <div class="form-row">
                <div class="form-group col-md-4">
                    <label asp-for="HttpMethod">Método HTTP</label>
                    <select asp-for="HttpMethod" class="form-control">
                        <option value="POST">POST</option>
                        <option value="PUT">PUT</option>
                        <option value="PATCH">PATCH</option>
                    </select>
                </div>
                <div class="form-group col-md-4">
                    <label asp-for="TimeoutSeconds">Timeout (seg)</label>
                    <input asp-for="TimeoutSeconds" class="form-control" type="number" min="5" max="300" />
                </div>
            </div>
            <div class="form-group">
                <label asp-for="HeadersJson">Headers (JSON opcional)</label>
                <textarea asp-for="HeadersJson" class="form-control font-monospace" rows="2"></textarea>
            </div>
            <div class="form-group">
                <label asp-for="PayloadTemplateJson">Plantilla del payload</label>
                <textarea asp-for="PayloadTemplateJson" class="form-control font-monospace" rows="8" required></textarea>
            </div>
            <div class="form-group">
                <label asp-for="RetryPolicyJson">Política de reintentos</label>
                <textarea asp-for="RetryPolicyJson" class="form-control font-monospace" rows="2"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            function validateJsonField(selector) {
                var $ta = $(selector);
                if (!$ta.length) return true;
                var val = $ta.val().trim();
                if (!val) return true; // empty is ok
                try {
                    JSON.parse(val);
                    $ta.removeClass('is-invalid');
                    $ta.next('.json-error').hide();
                    return true;
                } catch (e) {
                    $ta.addClass('is-invalid');
                    var errEl = $ta.next('.json-error');
                    if (!errEl.length) {
                        $ta.after('<div class="json-error text-danger small mt-1">JSON inválido: ' + e.message + '</div>');
                    } else {
                        errEl.text('JSON inválido: ' + e.message).show();
                    }
                    return false;
                }
            }

            var jsonFields = ['#HeadersJson', '#PayloadTemplateJson', '#RetryPolicyJson'];

            // Validate on blur
            jsonFields.forEach(function (sel) {
                $(sel).on('blur', function () { validateJsonField(sel); });
            });

            // Validate on form submit
            $('form').on('submit', function (e) {
                var valid = true;
                jsonFields.forEach(function (sel) {
                    if (!validateJsonField(sel)) valid = false;
                });
                if (!valid) e.preventDefault();
            });
        });
    </script>
}
