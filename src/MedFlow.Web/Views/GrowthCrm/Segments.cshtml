@using System.Collections.Generic
@using MedFlow.Application.Interfaces
<div class="mf-mission-control">
    <div class="mf-xp-card mf-xp-card-glass mb-4 p-4">
        <h2 class="h5 font-weight-bold mb-2" style="font-family:var(--mf-xp-font-display);">Segmentos con conteo</h2>
        <p class="text-muted small mb-0">Basado en el directorio actual del tenant. Las campañas automáticas multi-paso se configuran vía Automatizaciones + n8n.</p>
    </div>

    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="mf-xp-kpi h-100">
                <div class="mf-xp-kpi-label">Total pacientes</div>
                <div class="mf-xp-kpi-value">@ViewBag.CountAll</div>
                <a class="small d-inline-block mt-2" asp-controller="Patients" asp-action="Index">Abrir directorio</a>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="mf-xp-kpi h-100">
                <div class="mf-xp-kpi-label">Activos</div>
                <div class="mf-xp-kpi-value text-success">@ViewBag.CountActive</div>
                <a class="small d-inline-block mt-2" asp-controller="Patients" asp-action="Index" asp-route-estadoActivo="@(true)">Filtrar activos</a>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="mf-xp-kpi h-100">
                <div class="mf-xp-kpi-label">Inactivos</div>
                <div class="mf-xp-kpi-value text-warning">@ViewBag.CountInactive</div>
                <a class="small d-inline-block mt-2" asp-controller="Patients" asp-action="Index" asp-route-estadoActivo="@(false)">Filtrar inactivos</a>
            </div>
        </div>
    </div>

    @{
        var top = ViewBag.TopPatients as IReadOnlyList<PatientEngagementSummaryRow>;
    }
    @if (top != null && top.Count > 0)
    {
        <div class="mf-xp-card mb-4 p-0 overflow-hidden">
            <div class="card-header bg-transparent border-bottom"><strong>Top pacientes por citas (365 d)</strong></div>
            <div class="table-responsive mb-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="thead-light"><tr><th>Paciente</th><th class="text-right">Citas</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in top)
                        {
                            <tr>
                                <td>@r.PatientName</td>
                                <td class="text-right font-weight-bold">@r.AppointmentCount</td>
                                <td class="text-right"><a asp-controller="Patients" asp-action="Details" asp-route-id="@r.PatientId" class="btn btn-xs btn-outline-primary">Ver</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-lg-6 mb-3">
            <div class="mf-xp-card p-4 h-100">
                <h3 class="h6 font-weight-bold mb-3">Journeys (plantilla)</h3>
                <ol class="small text-muted pl-3 mb-0">
                    <li class="mb-2">Día 0: recordatorio de control (email / SMS según plantillas).</li>
                    <li class="mb-2">Día 7 sin respuesta: segunda pasada con beneficio o disponibilidad.</li>
                    <li>Día 30: segmento inactivos → workflow <code>PatientInactive</code> hacia n8n.</li>
                </ol>
            </div>
        </div>
        <div class="col-lg-6 mb-3">
            <div class="mf-xp-card p-4 h-100">
                <h3 class="h6 font-weight-bold mb-3">Scoring (próximo paso)</h3>
                <p class="small text-muted mb-2">
                    El scoring por visitas, facturación y apertura de mensajes puede persistirse en una tabla dedicada.
                    Mientras tanto, usa Mission Control + Motor IA Growth para priorizar acciones.
                </p>
                <a asp-area="AI" asp-controller="GrowthEngine" asp-action="Index" class="btn btn-sm btn-dark">Motor IA Growth</a>
            </div>
        </div>
    </div>
</div>
