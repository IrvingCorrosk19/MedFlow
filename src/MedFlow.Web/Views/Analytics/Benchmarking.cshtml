@model MedFlow.Web.Controllers.BenchmarkingViewModel
@{
    var b = Model.Benchmark;
}
<div class="row mb-2">
    <div class="col-12">
        <form method="get" class="form-inline">
            <input type="date" name="from" value="@ViewData["From"]" class="form-control form-control-sm mr-1" />
            <input type="date" name="to" value="@ViewData["To"]" class="form-control form-control-sm mr-1" />
            <select name="cohort" class="form-control form-control-sm mr-1">
                <option value="all" selected="@(ViewBag.Cohort == "all")">Todos los tenants</option>
                <option value="plan" selected="@(ViewBag.Cohort == "plan")">Por plan</option>
            </select>
            <button type="submit" class="btn btn-primary btn-sm">Aplicar</button>
        </form>
    </div>
</div>

@if (b != null)
{
<div class="row mb-4">
    <div class="col-12">
        <div class="card card-outline card-secondary shadow">
            <div class="card-header"><h3 class="card-title"><i class="fa fa-trophy"></i> Tu clinica vs cohorte</h3></div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="small-box bg-info">
                            <div class="inner"><h3>@b.CompletionRate.ToString("F0")%</h3><p>Tasa completitud</p></div>
                            <div class="icon"><i class="fa fa-check-circle"></i></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="small-box bg-warning">
                            <div class="inner"><h3>@b.CancellationRate.ToString("F0")%</h3><p>Cancelaciones</p></div>
                            <div class="icon"><i class="fa fa-times-circle"></i></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="small-box bg-danger">
                            <div class="inner"><h3>@b.NoShowRate.ToString("F0")%</h3><p>No-show</p></div>
                            <div class="icon"><i class="fa fa-user-times"></i></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="small-box bg-success">
                            <div class="inner"><h3>@b.RevenuePerDayAvg.ToString("N0")</h3><p>Ingresos/dia</p></div>
                            <div class="icon"><i class="fa fa-money"></i></div>
                        </div>
                    </div>
                </div>
                <div class="mt-2">
                    <span class="badge badge-light">Percentil completitud: @b.PercentileCompletion</span>
                    <span class="badge badge-light">Percentil ingresos: @b.PercentileRevenue</span>
                    @foreach (var f in b.Factors)
                    {
                        <span class="badge @(f.AboveAverage ? "badge-success" : "badge-secondary")">@f.Label: @(f.AboveAverage ? "Arriba" : "Abajo") vs cohorte</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
}
else
{
<div class="alert alert-info">No hay datos de benchmarking. Ejecuta agregaciones de snapshots.</div>
}

<div class="row">
    <div class="col-12">
        <div class="card card-outline card-primary shadow">
            <div class="card-header"><h3 class="card-title">Promedios por cohorte (anonimizado)</h3></div>
            <div class="card-body table-responsive p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="thead-light">
                        <tr><th>Cohorte</th><th>Tenants</th><th>Tasa completitud</th><th>Tasa cancelacion</th><th>Ingresos/dia</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Cohorts)
                        {
                        <tr>
                            <td>@c.Label</td>
                            <td>@c.TenantCount</td>
                            <td>@c.AvgCompletionRate.ToString("F1")%</td>
                            <td>@c.AvgCancellationRate.ToString("F1")%</td>
                            <td>@c.AvgRevenuePerDay.ToString("N0")</td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
