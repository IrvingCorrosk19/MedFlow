@model MedFlow.Web.Controllers.SnapshotsViewModel
@{
    ViewData["Title"] = "Snapshots";
}
<div class="row mb-2">
    <div class="col-12 d-flex flex-wrap justify-content-between align-items-center">
        <form method="get" class="form-inline">
            <input type="date" name="from" value="@ViewData["From"]" class="form-control form-control-sm mr-1" />
            <input type="date" name="to" value="@ViewData["To"]" class="form-control form-control-sm mr-1" />
            <button type="submit" class="btn btn-primary btn-sm">Aplicar</button>
        </form>
        @if (ViewBag.CanManage == true)
        {
        <div class="btn-group btn-group-sm">
            <form asp-action="Rebuild" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="date" value="@DateTime.UtcNow.AddDays(-1).ToString("yyyy-MM-dd")" />
                <button type="submit" class="btn btn-outline-warning"><i class="fa fa-refresh"></i> Reprocesar ayer</button>
            </form>
        </div>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{ <div class="alert alert-success alert-dismissible fade show"><button type="button" class="close" data-dismiss="alert">&times;</button>@TempData["Success"]</div> }
@if (TempData["Error"] != null)
{ <div class="alert alert-danger alert-dismissible fade show"><button type="button" class="close" data-dismiss="alert">&times;</button>@TempData["Error"]</div> }

<div class="row">
    <div class="col-lg-6">
        <div class="card card-outline card-primary shadow-sm">
            <div class="card-header"><h3 class="card-title">Snapshots diarios</h3></div>
            <div class="card-body table-responsive p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="thead-light"><tr><th>Fecha</th><th>Citas</th><th>Cancel.</th><th>Ingresos</th><th>Nuevos</th><th>IA</th><th>WF</th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.Snapshots.OrderByDescending(x => x.Date).Take(30))
                        {
                        <tr>
                            <td>@s.Date.ToString("dd/MM/yyyy")</td>
                            <td>@s.AppointmentsCompleted</td>
                            <td>@s.AppointmentsCancelled</td>
                            <td>@s.Revenue.ToString("N0")</td>
                            <td>@s.NewPatients</td>
                            <td>@s.AIInsightsGenerated</td>
                            <td>@s.WorkflowExecutions</td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card card-outline card-secondary shadow-sm">
            <div class="card-header"><h3 class="card-title">Jobs recientes</h3></div>
            <div class="card-body table-responsive p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="thead-light"><tr><th>Tipo</th><th>Fecha</th><th>Estado</th><th>Inicio</th></tr></thead>
                    <tbody>
                        @foreach (var j in Model.JobLogs)
                        {
                        <tr>
                            <td>@j.JobType</td>
                            <td>@(j.SnapshotDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td><span class="badge @(j.Status == "Completed" ? "badge-success" : j.Status == "Failed" ? "badge-danger" : "badge-warning")">@j.Status</span></td>
                            <td>@j.StartedAt.ToString("dd/MM HH:mm")</td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
