@model MedFlow.Web.ViewModels.PrescriptionFormViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-outline card-success">
            <div class="card-header">
                <h3 class="card-title"><i class="fa fa-medkit mr-1"></i> Nueva Receta</h3>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input asp-for="PatientId" type="hidden" />

                <div class="card-body">
                    <div asp-validation-summary="All" class="alert alert-danger" style="display:none" id="valSummary"></div>

                    @* Paciente + Consulta *@
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">Paciente</label>
                        <div class="col-sm-9">
                            <select asp-for="PatientId" asp-items="ViewBag.Patients" class="form-control select2"
                                    id="patientSelect" onchange="loadMedicalRecords(this.value)">
                                <option value="">-- Seleccione paciente --</option>
                            </select>
                            <span asp-validation-for="PatientId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label asp-for="MedicalRecordId" class="col-sm-3 col-form-label">Consulta asociada</label>
                        <div class="col-sm-9">
                            <select asp-for="MedicalRecordId" asp-items="ViewBag.MedicalRecords" class="form-control" id="medicalRecordSelect">
                                <option value="">-- Seleccione consulta --</option>
                            </select>
                            <span asp-validation-for="MedicalRecordId" class="text-danger"></span>
                            <small class="form-text text-muted">Seleccione primero un paciente para ver sus consultas.</small>
                        </div>
                    </div>

                    <hr />

                    @* Medicamento *@
                    <div class="form-group row">
                        <label asp-for="MedicationName" class="col-sm-3 col-form-label"></label>
                        <div class="col-sm-9">
                            <input asp-for="MedicationName" class="form-control" id="medicationInput"
                                   placeholder="Ej: Amoxicilina 500mg" autocomplete="off" />
                            <span asp-validation-for="MedicationName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label asp-for="Dosage" class="col-sm-3 col-form-label"></label>
                        <div class="col-sm-9">
                            <input asp-for="Dosage" class="form-control" placeholder="Ej: 1 cápsula" />
                            <span asp-validation-for="Dosage" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label asp-for="Frequency" class="col-sm-3 col-form-label"></label>
                        <div class="col-sm-9">
                            <input asp-for="Frequency" class="form-control" placeholder="Ej: Cada 8 horas" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label asp-for="Duration" class="col-sm-3 col-form-label"></label>
                        <div class="col-sm-9">
                            <input asp-for="Duration" class="form-control" placeholder="Ej: 7 días" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label asp-for="Instructions" class="col-sm-3 col-form-label"></label>
                        <div class="col-sm-9">
                            <textarea asp-for="Instructions" class="form-control" rows="2"
                                      placeholder="Tomar con alimentos, evitar alcohol..."></textarea>
                        </div>
                    </div>

                    <hr />

                    @* Prescriptor *@
                    <h6 class="text-muted mb-3">Datos del médico prescriptor</h6>

                    <div class="form-group row">
                        <label asp-for="PrescriberName" class="col-sm-3 col-form-label"></label>
                        <div class="col-sm-9">
                            <input asp-for="PrescriberName" class="form-control" placeholder="Dr. Juan Pérez" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label asp-for="PrescriberLicense" class="col-sm-3 col-form-label"></label>
                        <div class="col-sm-5">
                            <input asp-for="PrescriberLicense" class="form-control" placeholder="MP-12345" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label asp-for="IssuedAt" class="col-sm-3 col-form-label">Fecha de emisión</label>
                        <div class="col-sm-4">
                            <input asp-for="IssuedAt" type="date" class="form-control"
                                   value="@Model.IssuedAt.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-success">
                        <i class="fa fa-save mr-1"></i> Guardar receta
                    </button>
                    <a asp-action="Index" class="btn btn-default ml-2">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Init select2
        $('#patientSelect').select2({ placeholder: '-- Seleccione paciente --', width: '100%' });
        $('#patientSelect').on('change', function () { loadMedicalRecords(this.value); });

        function loadMedicalRecords(patientId) {
            if (!patientId) {
                $('#medicalRecordSelect').html('<option value="">-- Seleccione consulta --</option>');
                return;
            }
            $.get('/Prescriptions/MedicalRecordsByPatient?patientId=' + patientId, function (data) {
                var opts = '<option value="">-- Seleccione consulta --</option>';
                data.forEach(function (r) { opts += '<option value="' + r.id + '">' + r.display + '</option>'; });
                $('#medicalRecordSelect').html(opts);
            });
        }

        // Show validation summary if errors
        if ($('[data-valmsg-summary]').find('li').length > 0) {
            $('#valSummary').show();
        }

        // ── Medication autocomplete ─────────────────────────────────────────
        const MEDICATIONS = [
            'Acetaminofén 500mg','Acetaminofén 1g','Ácido acetilsalicílico 100mg','Ácido acetilsalicílico 500mg',
            'Ácido fólico 5mg','Ácido valproico 500mg','Albendazol 400mg','Amlodipino 5mg','Amlodipino 10mg',
            'Amoxicilina 250mg','Amoxicilina 500mg','Amoxicilina 875mg','Amoxicilina + Ácido clavulánico 875/125mg',
            'Ampicilina 500mg','Atenolol 50mg','Atenolol 100mg','Atorvastatina 10mg','Atorvastatina 20mg',
            'Atorvastatina 40mg','Azitromicina 250mg','Azitromicina 500mg','Betametasona 4mg/mL inyectable',
            'Captopril 25mg','Captopril 50mg','Carvedilol 6.25mg','Carvedilol 25mg','Cetirizina 10mg',
            'Ciprofloxacino 250mg','Ciprofloxacino 500mg','Claritromicina 250mg','Claritromicina 500mg',
            'Clindamicina 150mg','Clindamicina 300mg','Clonazepam 0.5mg','Clonazepam 2mg',
            'Dexametasona 4mg','Dexametasona 8mg','Diazepam 5mg','Diclofenaco 50mg','Diclofenaco 75mg',
            'Digoxina 0.25mg','Enalapril 5mg','Enalapril 10mg','Enalapril 20mg','Eritromicina 500mg',
            'Espironolactona 25mg','Espironolactona 100mg','Esomeprazol 20mg','Esomeprazol 40mg',
            'Fenitoína 100mg','Fluconazol 150mg','Fluoxetina 20mg','Furosemida 40mg',
            'Glibenclamida 5mg','Hidroclorotiazida 12.5mg','Hidroclorotiazida 25mg',
            'Ibuprofeno 200mg','Ibuprofeno 400mg','Ibuprofeno 600mg','Ibuprofeno 800mg',
            'Insulina NPH 100 UI/mL','Insulina Regular 100 UI/mL','Insulina Glargina 100 UI/mL',
            'Ketorolaco 10mg','Ketorolaco 30mg inyectable','Levofloxacino 500mg','Levofloxacino 750mg',
            'Levotiroxina 25mcg','Levotiroxina 50mcg','Levotiroxina 100mcg','Lisinopril 5mg',
            'Lisinopril 10mg','Lisinopril 20mg','Loratadina 10mg','Losartán 25mg','Losartán 50mg',
            'Losartán 100mg','Lorazepam 1mg','Lorazepam 2mg','Metformina 500mg','Metformina 850mg',
            'Metformina 1000mg','Metoclopramida 10mg','Metoprolol 25mg','Metoprolol 50mg',
            'Metronidazol 250mg','Metronidazol 500mg','Nifedipino 10mg','Nifedipino 30mg',
            'Omeprazol 20mg','Omeprazol 40mg','Ondansetrón 4mg','Ondansetrón 8mg',
            'Pantoprazol 20mg','Pantoprazol 40mg','Paracetamol 500mg','Paracetamol 1g',
            'Prednisona 5mg','Prednisona 20mg','Prednisona 50mg','Ranitidina 150mg','Ranitidina 300mg',
            'Salbutamol 100mcg inhalador','Salbutamol jarabe 2mg/5mL','Sertralina 50mg','Sertralina 100mg',
            'Simvastatina 20mg','Simvastatina 40mg','Tramadol 50mg','Tramadol 100mg',
            'Trimethoprim/Sulfametoxazol 80/400mg','Trimethoprim/Sulfametoxazol 160/800mg',
            'Valsartán 80mg','Valsartán 160mg','Warfarina 2mg','Warfarina 5mg'
        ];

        (function () {
            var $input = $('#medicationInput');
            var $drop = $('<ul id="medDrop" class="list-group shadow-sm" style="position:absolute;z-index:9999;max-height:220px;overflow-y:auto;display:none;min-width:100%;"></ul>');
            $input.parent().css('position', 'relative').append($drop);

            function filter(q) {
                var lq = q.toLowerCase().trim();
                if (!lq) { $drop.hide(); return; }
                var matches = MEDICATIONS.filter(function (m) { return m.toLowerCase().indexOf(lq) >= 0; }).slice(0, 10);
                if (!matches.length) { $drop.hide(); return; }
                $drop.html('');
                matches.forEach(function (m) {
                    var idx = m.toLowerCase().indexOf(lq);
                    var hi = m.substring(0, idx) + '<strong>' + m.substring(idx, idx + lq.length) + '</strong>' + m.substring(idx + lq.length);
                    $('<li class="list-group-item list-group-item-action py-1 px-2" style="cursor:pointer;font-size:.9rem;">')
                        .html(hi).data('val', m)
                        .on('mousedown', function (e) { e.preventDefault(); $input.val($(this).data('val')); $drop.hide(); })
                        .appendTo($drop);
                });
                $drop.show();
            }

            $input.on('input', function () { filter(this.value); });
            $input.on('keydown', function (e) {
                if (!$drop.is(':visible')) return;
                var $items = $drop.find('li');
                var $active = $items.filter('.active');
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    var $next = $active.length ? $active.removeClass('active').next() : $items.first();
                    $next.addClass('active');
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    var $prev = $active.length ? $active.removeClass('active').prev() : $items.last();
                    $prev.addClass('active');
                } else if (e.key === 'Enter' && $active.length) {
                    e.preventDefault();
                    $input.val($active.data('val'));
                    $drop.hide();
                } else if (e.key === 'Escape') {
                    $drop.hide();
                }
            });
            $input.on('blur', function () { setTimeout(function () { $drop.hide(); }, 150); });
        })();
    </script>
}
