@model MedFlow.Domain.Entities.Prescription
@{
    ViewData["PageTitle"] = "Detalle Receta";
    var patient = Model.MedicalRecord?.Patient;
    var doctor = Model.MedicalRecord?.Doctor;
    var doctorName = doctor != null
        ? $"Dr. {doctor.FullName}"
        : (Model.PrescriberName ?? "—");
}

<div class="row">
    <div class="col-md-8">
        <div class="card card-outline @(Model.IsVoid ? "card-danger" : "card-success") shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title font-weight-bold mb-0">
                    <i class="fa fa-pills mr-2"></i>Receta médica
                </h3>
                <div>
                    @if (Model.IsVoid)
                    {
                        <span class="badge badge-danger badge-lg px-3 py-2"><i class="fa fa-ban mr-1"></i>ANULADA</span>
                    }
                    else
                    {
                        <span class="badge badge-success badge-lg px-3 py-2"><i class="fa fa-check mr-1"></i>ACTIVA</span>
                        <a asp-action="Print" asp-route-id="@Model.Id" class="btn btn-primary btn-sm ml-2" target="_blank">
                            <i class="fa fa-file-pdf mr-1"></i>Descargar PDF
                        </a>
                    }
                    @if (patient != null)
                    {
                        <a asp-action="ByPatient" asp-route-patientId="@patient.Id" class="btn btn-default btn-sm ml-1">
                            <i class="fa fa-arrow-left mr-1"></i>Volver
                        </a>
                    }
                </div>
            </div>
            <div class="card-body">
                @if (Model.IsVoid && !string.IsNullOrWhiteSpace(Model.VoidReason))
                {
                    <div class="alert alert-danger mb-3">
                        <i class="fa fa-ban mr-1"></i><strong>Motivo de anulación:</strong> @Model.VoidReason
                    </div>
                }

                <!-- Datos del paciente y médico -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="bg-light rounded p-3">
                            <small class="text-muted d-block mb-1">PACIENTE</small>
                            <strong class="text-success">@(patient?.NombreCompleto ?? "—")</strong><br />
                            @if (!string.IsNullOrWhiteSpace(patient?.NumeroDocumento))
                            {
                                <small class="text-muted">Doc: @patient.NumeroDocumento</small>
                            }
                            @if (patient?.FechaNacimiento != null)
                            {
                                <small class="text-muted d-block">Nac: @patient.FechaNacimiento.Value.ToString("dd/MM/yyyy")</small>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bg-light rounded p-3">
                            <small class="text-muted d-block mb-1">MÉDICO</small>
                            <strong>@doctorName</strong><br />
                            @if (!string.IsNullOrWhiteSpace(Model.PrescriberLicense))
                            {
                                <small class="text-muted">Ced: @Model.PrescriberLicense</small>
                            }
                        </div>
                    </div>
                </div>

                <!-- Medicamento -->
                <h6 class="text-success font-weight-bold mb-3"><i class="fa fa-capsules mr-2"></i>Rp/</h6>
                <div class="border-left border-success pl-3 mb-3">
                    <h5 class="font-weight-bold mb-1">@Model.MedicationName</h5>
                    <div class="row text-sm">
                        <div class="col-md-3">
                            <small class="text-muted d-block">Dosis</small>
                            <span>@(Model.Dosage ?? "—")</span>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">Frecuencia</small>
                            <span>@(Model.Frequency ?? "—")</span>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">Duración</small>
                            <span>@(Model.Duration ?? "—")</span>
                        </div>
                        <div class="col-md-12 mt-2">
                            <small class="text-muted d-block">Indicaciones especiales</small>
                            <span class="text-muted fst-italic">@(Model.Instructions ?? "—")</span>
                        </div>
                    </div>
                </div>

                <div class="text-muted small border-top pt-2 mt-3">
                    <i class="fa fa-clock mr-1"></i>Emitida el @Model.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    &nbsp;|&nbsp;
                    <i class="fa fa-print mr-1"></i>@Model.PrintCount impresión(es)
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        @if (!Model.IsVoid)
        {
            <div class="card card-outline card-primary shadow-sm mb-3">
                <div class="card-header"><h3 class="card-title mb-0">Acciones</h3></div>
                <div class="card-body">
                    <a asp-action="Print" asp-route-id="@Model.Id" class="btn btn-primary btn-block mb-2" target="_blank">
                        <i class="fa fa-file-pdf mr-2"></i>Descargar PDF
                    </a>
                    <button type="button" class="btn btn-outline-danger btn-block btn-void-rx"
                            data-id="@Model.Id" data-patient="@patient?.Id">
                        <i class="fa fa-ban mr-2"></i>Anular receta
                    </button>
                </div>
            </div>
        }

        <div class="card card-outline card-secondary shadow-sm">
            <div class="card-header"><h3 class="card-title mb-0">Consulta relacionada</h3></div>
            <div class="card-body">
                @if (Model.MedicalRecord != null)
                {
                    <p class="mb-1">
                        <small class="text-muted">Fecha:</small><br />
                        <strong>@Model.MedicalRecord.VisitDate.ToLocalTime().ToString("dd/MM/yyyy")</strong>
                    </p>
                    @if (!string.IsNullOrWhiteSpace(Model.MedicalRecord.Diagnosis))
                    {
                        <p class="mb-0">
                            <small class="text-muted">Diagnóstico:</small><br />
                            @Model.MedicalRecord.Diagnosis
                        </p>
                    }
                    <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@Model.MedicalRecord.Id"
                       class="btn btn-outline-secondary btn-sm btn-block mt-2">
                        <i class="fa fa-file-medical mr-1"></i>Ver consulta
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal anular -->
<div class="modal fade" id="modalVoid" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fa fa-ban mr-2"></i>Anular Receta</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <form asp-action="Void" asp-controller="Prescriptions" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="patientId" value="@patient?.Id" />
                <div class="modal-body">
                    <div class="form-group mb-0">
                        <label>Motivo de anulación <span class="text-danger">*</span></label>
                        <textarea name="reason" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Anular</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-void-rx').forEach(btn => {
            btn.addEventListener('click', () => $('#modalVoid').modal('show'));
        });
    </script>
}
