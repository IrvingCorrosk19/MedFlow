@model MedFlow.Application.PatientPortal.PatientInvoiceListItemDto
@using MedFlow.Domain.Enums
@{
    ViewData["Title"] = $"Factura {Model.InvoiceNumber}";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
    var badge = Model.Status == InvoiceStatus.Paid ? "success"
        : Model.Status == InvoiceStatus.Cancelled ? "secondary"
        : Model.Status == InvoiceStatus.PartiallyPaid ? "warning" : "danger";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card card-outline card-primary shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title font-weight-bold mb-0">@Model.InvoiceNumber</h3>
                <div>
                    <span class="badge badge-@badge px-3 py-2">@Model.Status</span>
                    <a asp-action="Invoices" class="btn btn-default btn-sm ml-2">
                        <i class="fa fa-arrow-left mr-1"></i>Volver
                    </a>
                </div>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Fecha emisión</dt>
                    <dd class="col-sm-8">@Model.IssueDate.ToString("dd/MM/yyyy")</dd>

                    @if (Model.DueDate.HasValue)
                    {
                        <dt class="col-sm-4">Fecha vencimiento</dt>
                        <dd class="col-sm-8">@Model.DueDate.Value.ToString("dd/MM/yyyy")</dd>
                    }

                    <dt class="col-sm-4">Total</dt>
                    <dd class="col-sm-8 font-weight-bold">@Model.TotalAmount.ToString("N2")</dd>

                    <dt class="col-sm-4">Pagado</dt>
                    <dd class="col-sm-8 text-success">@Model.AmountPaid.ToString("N2")</dd>

                    <dt class="col-sm-4">Saldo pendiente</dt>
                    <dd class="col-sm-8 @(Model.BalanceDue > 0 ? "text-danger font-weight-bold" : "text-success")">
                        @Model.BalanceDue.ToString("N2")
                        @if (Model.BalanceDue == 0)
                        {
                            <i class="fa fa-check-circle text-success ml-1"></i>
                        }
                    </dd>
                </dl>

                @if (Model.BalanceDue > 0)
                {
                    <div class="alert alert-warning mt-3">
                        <i class="fa fa-info-circle mr-2"></i>
                        Tienes un saldo pendiente de <strong>@Model.BalanceDue.ToString("N2")</strong>.
                        Contáctanos para coordinar el pago.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
