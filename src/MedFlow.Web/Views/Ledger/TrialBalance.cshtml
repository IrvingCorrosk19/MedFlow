@using MedFlow.Application.Accounting
@using MedFlow.Domain.Enums
@model TrialBalanceDto
@{
    ViewData["PageTitle"] = "Balance de Comprobación";
}

<div class="card card-outline card-secondary shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row gx-2 align-items-end">
            <div class="col-auto">
                <label class="small text-muted d-block mb-1">Al día</label>
                <input type="date" name="asOf" class="form-control form-control-sm" value="@ViewBag.AsOf" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm"><i class="fa fa-refresh mr-1"></i>Actualizar</button>
            </div>
            <div class="col-auto ml-auto">
                <div class="btn-group btn-group-sm mr-2">
                    <a asp-action="ExportTrialBalance" asp-route-asOf="@ViewBag.AsOf" asp-route-format="csv" class="btn btn-outline-secondary">
                        <i class="fa fa-file-text-o mr-1"></i>CSV
                    </a>
                    <a asp-action="ExportTrialBalance" asp-route-asOf="@ViewBag.AsOf" asp-route-format="html" class="btn btn-outline-secondary">
                        <i class="fa fa-file-code-o mr-1"></i>HTML/PDF
                    </a>
                </div>
                <button onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="fa fa-print"></i></button>
            </div>
        </form>
    </div>
</div>

<div class="card card-outline card-primary shadow-sm">
    <div class="card-header">
        <h3 class="card-title font-weight-bold mb-0">
            Balance de Comprobación — Al @Model.AsOf.ToString("dd 'de' MMMM 'de' yyyy")
        </h3>
    </div>
    <div class="card-body p-0">
        <table class="table table-sm table-bordered mb-0">
            <thead class="thead-light">
                <tr>
                    <th>Código</th>
                    <th>Cuenta</th>
                    <th>Tipo</th>
                    <th class="text-right">Saldo Débito</th>
                    <th class="text-right">Saldo Crédito</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Lines)
                {
                    <tr>
                        <td><code>@l.AccountCode</code></td>
                        <td>@l.AccountName</td>
                        <td>@l.AccountType</td>
                        <td class="text-right">@(l.DebitBalance > 0 ? l.DebitBalance.ToString("N2") : "—")</td>
                        <td class="text-right">@(l.CreditBalance > 0 ? l.CreditBalance.ToString("N2") : "—")</td>
                    </tr>
                }
            </tbody>
            <tfoot class="font-weight-bold table-active">
                <tr>
                    <td colspan="3" class="text-right">TOTALES</td>
                    <td class="text-right @(Model.TotalDebit != Model.TotalCredit ? "text-danger" : "")">@Model.TotalDebit.ToString("N2")</td>
                    <td class="text-right @(Model.TotalDebit != Model.TotalCredit ? "text-danger" : "")">@Model.TotalCredit.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
    @if (Model.TotalDebit == Model.TotalCredit)
    {
        <div class="card-footer bg-success text-white text-center small">
            <i class="fa fa-check-circle mr-1"></i> Balance cuadrado correctamente
        </div>
    }
    else
    {
        <div class="card-footer bg-danger text-white text-center small">
            <i class="fa fa-exclamation-triangle mr-1"></i> DIFERENCIA: @Math.Abs(Model.TotalDebit - Model.TotalCredit).ToString("N2")
        </div>
    }
</div>
