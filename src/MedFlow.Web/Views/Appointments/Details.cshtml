@model MedFlow.Domain.Entities.Appointment
@using MedFlow.Domain.Enums
@{
    ViewData["Title"] = "Detalle de cita";
    ViewData["PageSubtitle"] = $"{Model.ScheduledDate:dd/MM/yyyy} {Model.StartTime:hh\\:mm}";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"" + Url.Action("Index") + "\">Citas</a></li><li class=\"breadcrumb-item active\">Detalle</li>";
    var canActuate = Model.Status == AppointmentStatus.Scheduled || Model.Status == AppointmentStatus.Confirmed;
}

<div class="card card-outline card-primary shadow-sm">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p><strong>Paciente:</strong> @(Model.Patient?.NombreCompleto ?? "—")</p>
                <p><strong>Doctor:</strong> @(Model.Doctor?.FullName ?? "—")</p>
                <p><strong>Fecha:</strong> @Model.ScheduledDate.ToString("dd/MM/yyyy")</p>
                <p><strong>Hora:</strong> @Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")</p>
            </div>
            <div class="col-md-6">
                <p><strong>Estado:</strong> @Model.Status</p>
                <p><strong>Consultorio:</strong> @(string.IsNullOrWhiteSpace(Model.ConsultationRoom) ? "—" : Model.ConsultationRoom)</p>
                <p><strong>Motivo:</strong> @(string.IsNullOrWhiteSpace(Model.Reason) ? "—" : Model.Reason)</p>
                <p><strong>Notas:</strong> @(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</p>
            </div>
        </div>
    </div>
</div>

<div class="mt-3 d-flex gap-2 flex-wrap">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="fa fa-edit"></i> Editar</a>
    @if (canActuate)
    {
        <form asp-action="MarkCompleted" asp-route-id="@Model.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success"
                    onclick="return confirm('¿Marcar esta cita como completada?');">
                <i class="fa fa-check"></i> Marcar como completada
            </button>
        </form>
        <form asp-action="MarkNoShow" asp-route-id="@Model.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-warning"
                    onclick="return confirm('¿Registrar esta cita como no-show?');">
                <i class="fa fa-user-times"></i> Registrar No-Show
            </button>
        </form>
    }
    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</div>
