@model MedFlow.Domain.Entities.Appointment
@using MedFlow.Domain.Enums
@{
    ViewData["Title"] = "Detalle de cita";
    ViewData["PageSubtitle"] = $"{Model.ScheduledDate:dd/MM/yyyy} {Model.StartTime:hh\\:mm}";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"" + Url.Action("Index") + "\">Citas</a></li><li class=\"breadcrumb-item active\">Detalle</li>";
    var canActuate = Model.Status == AppointmentStatus.Scheduled || Model.Status == AppointmentStatus.Confirmed;
    var suggestBilling = TempData["SuggestBilling"]?.ToString();
    var suggestAptId = TempData["SuggestBillingAptId"]?.ToString();
}

@if (!string.IsNullOrEmpty(suggestBilling))
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="fa fa-check-circle mr-2"></i>
        <strong>Cita completada.</strong> ¿Deseas generar una factura para este paciente?
        <a asp-controller="BillingInvoices" asp-action="Create"
           asp-route-patientId="@suggestBilling"
           asp-route-appointmentId="@suggestAptId"
           class="btn btn-sm btn-success ml-2">
            <i class="fa fa-file-text-o mr-1"></i> Crear factura
        </a>
        <a asp-controller="MedicalRecords" asp-action="Create"
           asp-route-patientId="@suggestBilling"
           class="btn btn-sm btn-outline-success ml-1">
            <i class="fa fa-stethoscope mr-1"></i> Nueva consulta
        </a>
        <button type="button" class="close" data-dismiss="alert">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card card-outline card-primary shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0">
                    <i class="fa fa-calendar-check-o mr-2"></i>
                    @Model.ScheduledDate.ToString("dddd, dd 'de' MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))
                </h3>
                @{
                    var statusClass = Model.Status switch
                    {
                        AppointmentStatus.Completed => "badge-success",
                        AppointmentStatus.Cancelled => "badge-danger",
                        AppointmentStatus.NoShow    => "badge-warning",
                        AppointmentStatus.Confirmed => "badge-primary",
                        _                           => "badge-secondary"
                    };
                }
                <span class="badge @statusClass px-3 py-2">@Model.Status</span>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <dl class="row mb-0 small">
                            <dt class="col-5 text-muted">Paciente</dt>
                            <dd class="col-7 font-weight-medium">@(Model.Patient?.NombreCompleto ?? "—")</dd>
                            <dt class="col-5 text-muted">Doctor</dt>
                            <dd class="col-7">@(Model.Doctor?.FullName ?? "—")</dd>
                            <dt class="col-5 text-muted">Consultorio</dt>
                            <dd class="col-7">@(string.IsNullOrWhiteSpace(Model.ConsultationRoom) ? "—" : Model.ConsultationRoom)</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="row mb-0 small">
                            <dt class="col-5 text-muted">Hora inicio</dt>
                            <dd class="col-7">@Model.StartTime.ToString(@"hh\:mm")</dd>
                            <dt class="col-5 text-muted">Hora fin</dt>
                            <dd class="col-7">@Model.EndTime.ToString(@"hh\:mm")</dd>
                            <dt class="col-5 text-muted">Motivo</dt>
                            <dd class="col-7">@(string.IsNullOrWhiteSpace(Model.Reason) ? "—" : Model.Reason)</dd>
                        </dl>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <hr class="my-2"/>
                    <p class="small mb-0"><strong>Notas:</strong> @Model.Notes</p>
                }
            </div>
        </div>

        <div class="d-flex flex-wrap" style="gap:8px">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                <i class="fa fa-edit mr-1"></i> Editar
            </a>
            @if (canActuate)
            {
                <button type="button" class="btn btn-info btn-sm" data-toggle="modal" data-target="#modalReschedule">
                    <i class="fa fa-calendar-plus-o mr-1"></i> Reagendar
                </button>
                <form asp-action="Confirm" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-success btn-sm">
                        <i class="fa fa-check mr-1"></i> Confirmar
                    </button>
                </form>
                <form asp-action="MarkCompleted" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success btn-sm"
                            onclick="return confirm('¿Marcar como completada?')">
                        <i class="fa fa-check-circle mr-1"></i> Completada
                    </button>
                </form>
                <form asp-action="MarkNoShow" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning btn-sm"
                            onclick="return confirm('¿Registrar como no-show?')">
                        <i class="fa fa-user-times mr-1"></i> No-Show
                    </button>
                </form>
            }
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Volver</a>
        </div>
    </div>

    @if (Model.Patient != null)
    {
        <div class="col-lg-4">
            <div class="card card-outline card-light shadow-sm mb-3">
                <div class="card-header"><h3 class="card-title mb-0 small">Acciones rápidas</h3></div>
                <div class="card-body p-2">
                    <a asp-controller="MedicalRecords" asp-action="Create" asp-route-patientId="@Model.Patient.Id"
                       class="btn btn-outline-success btn-block btn-sm mb-1">
                        <i class="fa fa-file-medical mr-1"></i> Nueva consulta
                    </a>
                    <a asp-controller="MedicalRecords" asp-action="Patient" asp-route-patientId="@Model.Patient.Id"
                       class="btn btn-outline-secondary btn-block btn-sm mb-1">
                        <i class="fa fa-history mr-1"></i> Historia clínica
                    </a>
                    <a asp-controller="BillingInvoices" asp-action="Index" asp-route-patientId="@Model.Patient.Id"
                       class="btn btn-outline-secondary btn-block btn-sm">
                        <i class="fa fa-file-text-o mr-1"></i> Facturas
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal Reagendar -->
@if (canActuate)
{
    <div class="modal fade" id="modalReschedule" tabindex="-1" aria-labelledby="rescheduleLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title" id="rescheduleLabel">
                        <i class="fa fa-calendar-plus-o mr-2"></i>Reagendar cita
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                </div>
                <form asp-action="Reschedule" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <p class="text-muted small mb-3">
                            Paciente: <strong>@(Model.Patient?.NombreCompleto ?? "—")</strong> —
                            Doctor: <strong>@(Model.Doctor?.FullName ?? "—")</strong>
                        </p>
                        <div class="form-group">
                            <label class="font-weight-medium">Nueva fecha <span class="text-danger">*</span></label>
                            <input type="date" name="newDate" class="form-control"
                                   value="@Model.ScheduledDate.ToString("yyyy-MM-dd")"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="form-row">
                            <div class="form-group col-6">
                                <label class="font-weight-medium">Hora inicio <span class="text-danger">*</span></label>
                                <input type="time" name="newStart" class="form-control"
                                       value="@Model.StartTime.ToString(@"hh\:mm")" required />
                            </div>
                            <div class="form-group col-6">
                                <label class="font-weight-medium">Hora fin <span class="text-danger">*</span></label>
                                <input type="time" name="newEnd" class="form-control"
                                       value="@Model.EndTime.ToString(@"hh\:mm")" required />
                            </div>
                        </div>
                        <div class="alert alert-warning small mb-0">
                            <i class="fa fa-info-circle mr-1"></i>
                            Se verificará automáticamente que no haya conflictos con otras citas del doctor.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-info">
                            <i class="fa fa-calendar-check-o mr-1"></i> Confirmar reagendamiento
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
