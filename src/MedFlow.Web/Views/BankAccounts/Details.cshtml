@model MedFlow.Domain.Entities.BankAccount
@{
    ViewData["PageTitle"] = "Detalle de Cuenta Bancaria";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="font-weight-bold mb-0"><i class="fa fa-bank mr-2"></i>@Model.Name</h4>
    <div>
        <a asp-action="Transactions" asp-route-id="@Model.Id" class="btn btn-primary btn-sm"><i class="fa fa-list mr-1"></i>Movimientos</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm"><i class="fa fa-pencil mr-1"></i>Editar</a>
        <a asp-action="Index" class="btn btn-secondary btn-sm"><i class="fa fa-arrow-left mr-1"></i>Volver</a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        @TempData["Error"]
    </div>
}

<div class="card card-outline card-info shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Banco</dt>
            <dd class="col-sm-9">@Model.BankName</dd>

            <dt class="col-sm-3">Número de cuenta</dt>
            <dd class="col-sm-9">@(Model.AccountNumber ?? "—")</dd>

            <dt class="col-sm-3">Moneda</dt>
            <dd class="col-sm-9"><span class="badge badge-light">@(Model.Currency ?? "USD")</span></dd>

            <dt class="col-sm-3">Saldo inicial</dt>
            <dd class="col-sm-9 font-weight-bold">@Model.OpeningBalance.ToString("N2")</dd>

            <dt class="col-sm-3">Cuenta contable vinculada</dt>
            <dd class="col-sm-9">
                @if (Model.Account != null)
                {
                    <code>@Model.Account.Code</code> <span>— @Model.Account.Name</span>
                }
                else
                {
                    <span>—</span>
                }
            </dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge badge-success">Activa</span>
                }
                else
                {
                    <span class="badge badge-secondary">Inactiva</span>
                }
            </dd>

            <dt class="col-sm-3">Creada</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
    </div>
    <div class="card-footer text-muted small">
        El saldo actual se calcula a partir de los movimientos registrados.
        <a asp-action="Transactions" asp-route-id="@Model.Id">Ver movimientos</a>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3 frm-del-details">
    @Html.AntiForgeryToken()
    <button type="button" class="btn btn-danger btn-sm btn-del-details">
        <i class="fa fa-trash mr-1"></i>Eliminar cuenta bancaria
    </button>
</form>

@section Scripts {
<script>
$(function () {
    $(document).on('click', '.btn-del-details', function () {
        var f = $(this).closest('form');
        Swal.fire({
            title: '¿Eliminar esta cuenta bancaria?',
            text: 'Esta acción no se puede deshacer.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar'
        }).then(function (r) { if (r.isConfirmed) f.submit(); });
    });
});
</script>
}
