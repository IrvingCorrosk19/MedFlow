@model MedFlow.Web.Models.Accounting.BankAccountFormViewModel
@{
    ViewData["PageTitle"] = "Nueva Cuenta Bancaria";
}

<div class="card card-outline card-success shadow-sm" style="max-width:540px">
    <div class="card-header">
        <h3 class="card-title font-weight-bold"><i class="fa fa-bank mr-2"></i>Nueva Cuenta Bancaria</h3>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-group">
                <label asp-for="Name">Nombre de la cuenta</label>
                <input asp-for="Name" class="form-control" placeholder="Ej: Banco Nacional - Cta Corriente" required />
            </div>
            <div class="form-group">
                <label asp-for="BankName">Nombre del banco</label>
                <input asp-for="BankName" class="form-control" placeholder="Ej: Banco Nacional" required />
            </div>
            <div class="form-group">
                <label asp-for="AccountNumber">Número de cuenta</label>
                <input asp-for="AccountNumber" class="form-control" placeholder="XXXX-XXXX-XXXX" />
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Currency">Moneda</label>
                        <input asp-for="Currency" class="form-control" value="USD" placeholder="USD, EUR, MXN..." />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="OpeningBalance">Saldo inicial</label>
                        <input asp-for="OpeningBalance" type="number" step="0.01" class="form-control" value="0" />
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label>Cuenta contable vinculada (opcional)</label>
                <select name="AccountId" class="form-control custom-select">
                    <option value="">— Sin vincular —</option>
                    @foreach (var item in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.ChartAccounts)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>

            <div class="d-flex justify-content-end">
                <a asp-action="Index" class="btn btn-secondary mr-2">Cancelar</a>
                <button type="submit" class="btn btn-success"><i class="fa fa-save mr-1"></i>Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
