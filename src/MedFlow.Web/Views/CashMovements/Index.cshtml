@model IReadOnlyList<MedFlow.Domain.Entities.CashMovement>
@using MedFlow.Domain.Enums
@{
    ViewData["PageTitle"] = "Caja";
    var day = ViewBag.Day as string;
    var fromVal = ViewBag.From as string;
    var toVal = ViewBag.To as string;
    bool isRange = ViewBag.IsRange == true;
}

<div class="card card-outline card-primary shadow-sm mb-3">
    <div class="card-body">
        <form method="get">
            <div class="row align-items-end gx-2">
                <div class="col-auto">
                    <label class="small text-muted d-block mb-1">Día exacto</label>
                    <input type="date" name="day" class="form-control form-control-sm" value="@(isRange ? "" : day)" />
                </div>
                <div class="col-auto d-flex align-items-center pt-3 text-muted small px-2">ó rango</div>
                <div class="col-auto">
                    <label class="small text-muted d-block mb-1">Desde</label>
                    <input type="date" name="from" class="form-control form-control-sm" value="@(isRange ? fromVal : "")" />
                </div>
                <div class="col-auto">
                    <label class="small text-muted d-block mb-1">Hasta</label>
                    <input type="date" name="to" class="form-control form-control-sm" value="@(isRange ? toVal : "")" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary btn-sm mt-3"><i class="fa fa-calendar"></i> Ver</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-3">
        <div class="small-box bg-success">
            <div class="inner">
                <h3>@(((decimal)ViewBag.Income).ToString("N2"))</h3>
                <p>Ingresos</p>
            </div>
            <div class="icon"><i class="fa fa-arrow-circle-up"></i></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="small-box bg-danger">
            <div class="inner">
                <h3>@(((decimal)ViewBag.Expense).ToString("N2"))</h3>
                <p>Egresos</p>
            </div>
            <div class="icon"><i class="fa fa-arrow-circle-down"></i></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="small-box bg-info">
            <div class="inner">
                <h3>@(((decimal)ViewBag.Net).ToString("N2"))</h3>
                <p>Neto @(isRange ? "del período" : "día")</p>
            </div>
            <div class="icon"><i class="fa fa-balance-scale"></i></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="small-box bg-secondary">
            <div class="inner">
                <h3>@(((decimal)ViewBag.Adjustment).ToString("N2"))</h3>
                <p>Ajustes</p>
            </div>
            <div class="icon"><i class="fa fa-wrench"></i></div>
        </div>
    </div>
</div>

<div class="card card-outline card-secondary shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title font-weight-bold mb-0">Movimientos</h3>
        <a asp-action="Create" class="btn btn-success btn-sm"><i class="fa fa-plus"></i> Nuevo movimiento</a>
    </div>
    <div class="card-body table-responsive p-0">
        <table id="tblC" class="table table-hover mb-0">
            <thead class="thead-light">
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th class="text-right">Monto</th>
                    <th>Descripción</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    var cls = m.MovementType == CashMovementType.Income ? "success" : m.MovementType == CashMovementType.Expense ? "danger" : "warning";
                    <tr>
                        <td>@m.MovementDate.ToLocalTime().ToString("g")</td>
                        <td><span class="badge badge-@cls">@m.MovementType</span></td>
                        <td class="text-right font-weight-medium">@m.Amount.ToString("N2")</td>
                        <td>@(m.Description ?? "—")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@m.Id" class="btn btn-xs btn-default mr-1" title="Ver detalle"><i class="fa fa-eye"></i></a>
                            @if (m.RelatedPaymentId == null)
                            {
                                <form asp-action="Delete" method="post" class="d-inline frm-del-mov">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@m.Id" />
                                    <input type="hidden" name="day" value="@ViewBag.Day" />
                                    @if (isRange)
                                    {
                                        <input type="hidden" name="from" value="@fromVal" />
                                        <input type="hidden" name="to" value="@toVal" />
                                    }
                                    <button type="button" class="btn btn-xs btn-outline-danger btn-del-mov" title="Eliminar"><i class="fa fa-trash"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#tblC').DataTable({ order: [[0, 'desc']], pageLength: 50, language: { url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json' } });
            $(document).on('click', '.btn-del-mov', function () {
                var f = $(this).closest('form');
                Swal.fire({ title: '¿Eliminar movimiento?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Sí, eliminar', cancelButtonText: 'Cancelar' })
                    .then(function (r) { if (r.isConfirmed) f.submit(); });
            });
        });
    </script>
}
