@model MedFlow.Domain.Entities.CashMovement
@using MedFlow.Domain.Enums
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var typeLabel = Model.MovementType == CashMovementType.Income ? "Ingreso"
                  : Model.MovementType == CashMovementType.Expense ? "Egreso"
                  : "Ajuste";
    var typeClass = Model.MovementType == CashMovementType.Income ? "success"
                  : Model.MovementType == CashMovementType.Expense ? "danger"
                  : "warning";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-outline card-@typeClass shadow-sm">
            <div class="card-header">
                <h3 class="card-title">
                    <span class="badge badge-@typeClass mr-2">@typeLabel</span>
                    Movimiento de caja
                </h3>
                <div class="card-tools">
                    <a asp-action="Index" asp-route-day="@Model.MovementDate.ToLocalTime().ToString("yyyy-MM-dd")"
                       class="btn btn-default btn-sm">
                        <i class="fa fa-arrow-left mr-1"></i> Volver
                    </a>
                </div>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted small">Fecha</dt>
                    <dd class="col-sm-8 font-weight-bold">@Model.MovementDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4 text-muted small">Tipo</dt>
                    <dd class="col-sm-8"><span class="badge badge-@typeClass">@typeLabel</span></dd>

                    <dt class="col-sm-4 text-muted small">Monto</dt>
                    <dd class="col-sm-8">
                        <span class="h4 font-weight-bold text-@typeClass">
                            @(Model.MovementType == CashMovementType.Expense ? "-" : "+")@Model.Amount.ToString("N2")
                        </span>
                    </dd>

                    <dt class="col-sm-4 text-muted small">Descripción</dt>
                    <dd class="col-sm-8">@(Model.Description ?? "—")</dd>

                    <dt class="col-sm-4 text-muted small">ID</dt>
                    <dd class="col-sm-8 text-muted small font-monospace">@Model.Id</dd>

                    <dt class="col-sm-4 text-muted small">Registrado por</dt>
                    <dd class="col-sm-8 text-muted small">@(string.IsNullOrEmpty(Model.CreatedByUserId) ? "—" : Model.CreatedByUserId)</dd>

                    <dt class="col-sm-4 text-muted small">Creado</dt>
                    <dd class="col-sm-8 text-muted small">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
            </div>
            <div class="card-footer">
                <form asp-action="Delete" method="post" class="d-inline"
                      onsubmit="return confirm('¿Eliminar este movimiento? Esta acción no se puede deshacer.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="day" value="@Model.MovementDate.ToLocalTime().ToString("yyyy-MM-dd")" />
                    <button type="submit" class="btn btn-danger btn-sm">
                        <i class="fa fa-trash mr-1"></i> Eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
