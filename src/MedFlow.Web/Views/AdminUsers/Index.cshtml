@model IReadOnlyList<MedFlow.Application.Interfaces.AdminUserListItem>
@{
    ViewData["Title"] = "Usuarios";
    ViewData["PageSubtitle"] = "Cuentas y acceso al sistema";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item active\">Usuarios</li>";
}

<div class="card card-outline card-primary shadow-sm">
    <div class="card-header d-flex flex-wrap align-items-center justify-content-between">
        <h3 class="card-title mb-0"><i class="fa fa-users mr-2"></i>Usuarios</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm mt-2 mt-sm-0">
            <i class="fa fa-user-plus"></i> Nuevo usuario
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tblUsers" class="table table-hover table-striped mb-0 text-nowrap">
                <thead class="thead-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Usuario</th>
                        <th>Roles</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Bloqueo</th>
                        <th>Último acceso</th>
                        <th class="text-right no-sort">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="font-weight-medium">@(u.FullName ?? "—")</td>
                            <td>@(u.Email ?? "—")</td>
                            <td>@(u.UserName ?? "—")</td>
                            <td>
                                @if (u.Roles.Count > 0)
                                {
                                    foreach (var r in u.Roles)
                                    {
                                        <span class="badge badge-info mr-1">@r</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (u.IsActive)
                                {
                                    <span class="badge badge-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (u.IsLocked)
                                {
                                    <span class="badge badge-warning">Sí</span>
                                }
                                else
                                {
                                    <span class="badge badge-light border">No</span>
                                }
                            </td>
                            <td>
                                @if (u.LastLoginAt.HasValue)
                                {
                                    <span title="@u.LastLoginAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")">
                                        @u.LastLoginAt.Value.ToLocalTime().ToString("dd/MM/yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-right text-nowrap">
                                <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-info" title="Ver detalle" aria-label="Ver detalle de @(u.FullName ?? u.Email)"><i class="fa fa-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-primary" title="Editar" aria-label="Editar @(u.FullName ?? u.Email)"><i class="fa fa-edit"></i></a>
                                @if (u.IsLocked)
                                {
                                    <form asp-action="UnlockUser" asp-route-id="@u.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-warning" title="Desbloquear usuario" aria-label="Desbloquear @(u.FullName ?? u.Email)" onclick="return confirm('¿Desbloquear este usuario?')">
                                            <i class="fa fa-unlock"></i>
                                        </button>
                                    </form>
                                }
                                <form asp-action="SendPasswordReset" asp-route-id="@u.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Generar enlace de restablecimiento de contraseña" aria-label="Reset contraseña @(u.FullName ?? u.Email)" onclick="return confirm('¿Generar enlace de restablecimiento de contraseña para este usuario?')">
                                        <i class="fa fa-key"></i>
                                    </button>
                                </form>
                                <form asp-action="SetActive" asp-route-id="@u.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="active" value="@(!u.IsActive)" />
                                    <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-secondary" : "btn-outline-success")"
                                            title="@(u.IsActive ? "Desactivar" : "Activar")"
                                            aria-label="@(u.IsActive ? "Desactivar" : "Activar") @(u.FullName ?? u.Email)"
                                            onclick="return confirm('@(u.IsActive ? "¿Desactivar este usuario?" : "¿Activar este usuario?")')">
                                        <i class="fa @(u.IsActive ? "fa-ban" : "fa-check")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#tblUsers').DataTable({
                responsive: true,
                pageLength: 25,
                order: [[0, 'asc']],
                language: { url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json' },
                columnDefs: [{ orderable: false, targets: 'no-sort' }]
            });
        });
    </script>
}
