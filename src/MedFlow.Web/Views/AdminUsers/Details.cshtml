@model MedFlow.Application.Interfaces.AdminUserDetails
@{
    ViewData["Title"] = Model.FullName ?? Model.Email ?? "Usuario";
    ViewData["PageSubtitle"] = Model.Email;
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"" + Url.Action("Index") + "\">Usuarios</a></li><li class=\"breadcrumb-item active\">Detalle</li>";
}

<div class="row">
    <div class="col-lg-8">
        <div class="card card-outline card-primary shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0"><i class="fa fa-user mr-2"></i>Perfil</h3>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary"><i class="fa fa-edit"></i> Editar</a>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Nombre completo</dt>
                    <dd class="col-sm-8">@(Model.FullName ?? "—")</dd>
                    <dt class="col-sm-4 text-muted">Correo</dt>
                    <dd class="col-sm-8">@(Model.Email ?? "—")</dd>
                    <dt class="col-sm-4 text-muted">Usuario</dt>
                    <dd class="col-sm-8">@(Model.UserName ?? "—")</dd>
                    <dt class="col-sm-4 text-muted">Teléfono</dt>
                    <dd class="col-sm-8">@(Model.PhoneNumber ?? "—")</dd>
                    <dt class="col-sm-4 text-muted">Último acceso</dt>
                    <dd class="col-sm-8">@(Model.LastLoginAt?.ToLocalTime().ToString("g") ?? "—")</dd>
                    <dt class="col-sm-4 text-muted">Creado</dt>
                    <dd class="col-sm-8">@(Model.CreatedAt?.ToLocalTime().ToString("g") ?? "—")</dd>
                </dl>
            </div>
        </div>
        <div class="card card-outline card-secondary shadow-sm">
            <div class="card-header"><h3 class="card-title mb-0"><i class="fa fa-id-badge mr-2"></i>Roles</h3></div>
            <div class="card-body">
                @if (Model.Roles.Count > 0)
                {
                    foreach (var r in Model.Roles)
                    {
                        <span class="badge badge-info mr-1 mb-1">@r</span>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">Sin roles asignados.</p>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card card-outline card-warning shadow-sm">
            <div class="card-header"><h3 class="card-title mb-0">Estado</h3></div>
            <div class="card-body">
                <p class="mb-2">
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge badge-secondary">Inactivo</span>
                    }
                    @if (Model.IsLocked)
                    {
                        <span class="badge badge-warning ml-1">Bloqueado</span>
                    }
                </p>
                <form asp-action="SetActive" method="post" class="d-inline" data-confirm="@(Model.IsActive ? "¿Desactivar este usuario?" : "")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    @if (Model.IsActive)
                    {
                        <input type="hidden" name="active" value="false" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Desactivar</button>
                    }
                    else
                    {
                        <input type="hidden" name="active" value="true" />
                        <button type="submit" class="btn btn-success btn-sm">Activar</button>
                    }
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('form[data-confirm]').on('submit', function (e) {
                var f = this;
                var msg = $(f).data('confirm');
                if (!msg) return;
                e.preventDefault();
                if (window.Swal) {
                    Swal.fire({
                        title: msg,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Sí',
                        cancelButtonText: 'Cancelar'
                    }).then(function (r) { if (r.isConfirmed) f.submit(); });
                } else if (confirm(msg)) f.submit();
            });
        });
    </script>
}
