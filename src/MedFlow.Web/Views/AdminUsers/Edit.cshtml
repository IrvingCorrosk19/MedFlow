@model MedFlow.Web.ViewModels.AdminUserFormViewModel
@{
    ViewData["Title"] = "Editar usuario";
    ViewData["PageSubtitle"] = Model.Email;
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"" + Url.Action("Index") + "\">Usuarios</a></li><li class=\"breadcrumb-item active\">Editar</li>";
}

<div class="card card-outline card-primary shadow-sm">
    <div class="card-header"><h3 class="card-title mb-0">Editar usuario</h3></div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="UserName">Usuario</label>
                    <input asp-for="UserName" class="form-control" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="NewPassword">Nueva contraseña (opcional)</label>
                    <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-3">
                    <label asp-for="FirstName">Nombre</label>
                    <input asp-for="FirstName" class="form-control" />
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="MiddleName">Segundo nombre</label>
                    <input asp-for="MiddleName" class="form-control" />
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="LastName">Apellido</label>
                    <input asp-for="LastName" class="form-control" />
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="SecondLastName">Segundo apellido</label>
                    <input asp-for="SecondLastName" class="form-control" />
                </div>
            </div>
            <div class="form-group">
                <label asp-for="PhoneNumber">Teléfono</label>
                <input asp-for="PhoneNumber" class="form-control" />
            </div>
            <div class="form-group">
                <div class="custom-control custom-switch">
                    <input asp-for="IsActive" class="custom-control-input" />
                    <label asp-for="IsActive" class="custom-control-label">Usuario activo</label>
                </div>
            </div>
            <div class="form-group">
                <div class="custom-control custom-switch">
                    <input asp-for="IsLocked" class="custom-control-input" />
                    <label asp-for="IsLocked" class="custom-control-label">Cuenta bloqueada</label>
                </div>
            </div>
            <div class="form-group">
                <label>Roles</label>
                <div class="border rounded p-3 bg-light">
                    @foreach (var rn in Model.AllRoleNames)
                    {
                        var id = "role_" + rn.Replace(" ", "_");
                        <div class="custom-control custom-checkbox">
                            <input class="custom-control-input" type="checkbox" name="RoleNames" value="@rn" id="@id" @(Model.RoleNames.Contains(rn, StringComparer.OrdinalIgnoreCase) ? "checked" : null) />
                            <label class="custom-control-label" for="@id">@rn</label>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-default">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
