@model IReadOnlyList<MedFlow.Domain.Entities.Payment>
@using MedFlow.Domain.Enums
@{
    ViewData["PageTitle"] = "Pagos";
    var patients = ViewBag.Patients as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div class="card card-outline card-primary shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="form-row align-items-end">
            <div class="form-group col-md-3">
                <label class="small text-muted">Paciente</label>
                <select name="patientId" class="form-control form-control-sm select2" asp-items="patients">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="form-group col-md-2">
                <label class="small text-muted">Desde</label>
                <input type="date" name="from" class="form-control form-control-sm" value="@ViewBag.From" />
            </div>
            <div class="form-group col-md-2">
                <label class="small text-muted">Hasta</label>
                <input type="date" name="to" class="form-control form-control-sm" value="@ViewBag.To" />
            </div>
            <div class="form-group col-md-2">
                <label class="small text-muted">Método</label>
                <select name="method" class="form-control form-control-sm">
                    <option value="">Todos</option>
                    @foreach (ClinicalPaymentMethod m in Enum.GetValues<ClinicalPaymentMethod>())
                    {
                        <option value="@((int)m)" selected="@(ViewBag.Method != null && (ClinicalPaymentMethod)ViewBag.Method == m)">@m</option>
                    }
                </select>
            </div>
            <div class="form-group col-md-3">
                <button type="submit" class="btn btn-primary btn-sm"><i class="fa fa-filter"></i> Filtrar</button>
                <a asp-action="Create" class="btn btn-outline-secondary btn-sm">Registrar pago</a>
            </div>
        </form>
    </div>
</div>

<div class="card card-outline card-secondary shadow-sm">
    <div class="card-header border-0">
        <h3 class="card-title font-weight-bold"><i class="fa fa-list mr-2"></i>Historial</h3>
    </div>
    <div class="card-body table-responsive p-0">
        <table id="tblP" class="table table-hover table-striped mb-0">
            <thead class="thead-light">
                <tr>
                    <th>Fecha</th>
                    <th>Factura</th>
                    <th>Paciente</th>
                    <th class="text-right">Monto</th>
                    <th>Método</th>
                    <th>Estado</th>
                    <th class="text-right">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.PaymentDate.ToLocalTime().ToString("g")</td>
                        <td>@p.BillingInvoice?.InvoiceNumber</td>
                        <td>@p.Patient?.NombreCompleto</td>
                        <td class="text-right font-weight-medium">@p.Amount.ToString("N2")</td>
                        <td>@p.PaymentMethod</td>
                        <td><span class="badge badge-@(p.Status == PaymentEntryStatus.Registered ? "success" : "secondary")">@p.Status</span></td>
                        <td class="text-right">
                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('.select2').select2({ theme: 'bootstrap4', width: '100%' });
            $('#tblP').DataTable({
                order: [[0, 'desc']],
                pageLength: 25,
                language: { url: '/lib/datatables/es-ES.json' }
            });
        });
    </script>
}
