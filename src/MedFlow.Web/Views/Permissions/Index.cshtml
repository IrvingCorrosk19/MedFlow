@model IReadOnlyList<MedFlow.Domain.Entities.Permission>
@{
    ViewData["Title"] = "Permisos";
    ViewData["PageSubtitle"] = "Catálogo de permisos del sistema";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item active\">Permisos</li>";
}

<div class="card card-outline card-info shadow-sm">
    <div class="card-header"><h3 class="card-title mb-0"><i class="fa fa-list-alt mr-2"></i>Catálogo</h3></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tblPerms" class="table table-hover table-striped mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Módulo</th>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td><span class="badge badge-secondary">@p.Module</span></td>
                            <td><code>@p.Code</code></td>
                            <td>@p.Name</td>
                            <td class="text-center">
                                @if (p.IsActive)
                                {
                                    <span class="badge badge-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">Inactivo</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#tblPerms').DataTable({
                responsive: true,
                pageLength: 50,
                order: [[0, 'asc'], [1, 'asc']],
                language: { url: '/lib/datatables/es-ES.json' }
            });
        });
    </script>
}
