@model MedFlow.Web.Models.Accounting.TaxRateFormViewModel
@{
    ViewData["PageTitle"] = "Nueva Tasa de Impuesto";
}

<div class="card card-outline card-success shadow-sm" style="max-width:500px">
    <div class="card-header">
        <h3 class="card-title font-weight-bold"><i class="fa fa-plus-circle mr-2"></i>Nueva Tasa de Impuesto</h3>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-group">
                <label asp-for="Name">Nombre</label>
                <input asp-for="Name" class="form-control" placeholder="Ej: IVA 19%, IGV 18%" required />
            </div>
            <div class="form-group">
                <label asp-for="Code">Código</label>
                <input asp-for="Code" class="form-control" placeholder="Ej: IVA, IGV" required />
            </div>
            <div class="form-group">
                <label asp-for="Rate">Tasa (%)</label>
                <input asp-for="Rate" type="number" step="0.01" min="0" max="100" class="form-control" required />
            </div>
            <div class="form-group">
                <label>Cuenta contable (opcional)</label>
                <select name="TaxAccountId" class="form-control custom-select">
                    <option value="">— Sin cuenta vinculada —</option>
                    @foreach (var item in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.TaxAccounts)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <div class="custom-control custom-switch">
                    <input type="checkbox" asp-for="IsDefault" class="custom-control-input" id="isDefault" />
                    <label class="custom-control-label" for="isDefault">Tasa predeterminada</label>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <a asp-action="Index" class="btn btn-secondary mr-2">Cancelar</a>
                <button type="submit" class="btn btn-success"><i class="fa fa-save mr-1"></i>Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
