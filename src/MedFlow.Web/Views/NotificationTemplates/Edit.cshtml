@model NotificationTemplateEditDto
@using MedFlow.Domain.Enums
<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post">
            @Html.AntiForgeryToken()
            <div class="form-row">
                <div class="form-group col-md-4">
                    <label>Evento</label>
                    <select asp-for="EventType" class="form-control" asp-items="Html.GetEnumSelectList<NotificationEventType>()"></select>
                </div>
                <div class="form-group col-md-4">
                    <label>Canal</label>
                    <select asp-for="Channel" class="form-control" asp-items="Html.GetEnumSelectList<NotificationChannel>()"></select>
                </div>
                <div class="form-group col-md-4">
                    <label>Código</label>
                    <input asp-for="Code" class="form-control" />
                </div>
            </div>
            <div class="form-group">
                <label>Nombre</label>
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>Asunto (Email)</label>
                    <input asp-for="SubjectTemplate" class="form-control" />
                </div>
                <div class="form-group col-md-6">
                    <label>From Email</label>
                    <input asp-for="FromEmail" class="form-control" type="email" />
                </div>
            </div>
            <div class="form-group">
                <label>Cuerpo (texto)</label>
                <textarea asp-for="BodyTemplate" class="form-control" rows="4"></textarea>
            </div>
            <div class="form-group">
                <label>Cuerpo HTML (opcional)</label>
                <textarea asp-for="HtmlBodyTemplate" class="form-control" rows="6"></textarea>
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>Webhook URL</label>
                    <input asp-for="WebhookUrl" class="form-control" />
                </div>
                <div class="form-group col-md-6">
                    <div class="form-check pt-4">
                        <input asp-for="IsDefault" class="form-check-input" />
                        <label asp-for="IsDefault" class="form-check-label">Plantilla por defecto</label>
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
