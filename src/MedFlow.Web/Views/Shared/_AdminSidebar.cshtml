                {
                    <li class="nav-header text-uppercase small text-muted">Operación clínica</li>
                    <li class="nav-item has-treeview @(openClinica ? "menu-open" : "")">
                        <a href="#" class="nav-link @(openClinica ? "active" : "")">
                            <i class="nav-icon fa fa-stethoscope"></i>
                            <p>Clínica <i class="right fa fa-angle-left"></i></p>
                        </a>
                        <ul class="nav nav-treeview">
                            @if (canSeePacientes)
                            {
                                <li class="nav-item">
                                    <a asp-controller="Patients" asp-action="Index" class="nav-link @Active("Patients")">
                                        <i class="fa fa-circle-o nav-icon"></i>
                                        <p>Pacientes</p>
                                    </a>
                                </li>
                            }
                            @if (canSeeDoctores)
                            {
                                <li class="nav-item">
                                    <a asp-controller="Doctors" asp-action="Index" class="nav-link @Active("Doctors")">
                                        <i class="fa fa-circle-o nav-icon"></i>
                                        <p>Doctores</p>
                                    </a>
                                </li>
                            }
                            @if (canSeeCitas)
                            {
                                <li class="nav-item">
                                    <a asp-controller="Appointments" asp-action="Index" class="nav-link @Active("Appointments","Index")">
                                        <i class="fa fa-circle-o nav-icon"></i>
                                        <p>Citas</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Appointments" asp-action="Calendar" class="nav-link @Active("Appointments","Calendar")">
                                        <i class="fa fa-calendar nav-icon"></i>
                                        <p>Calendario</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Appointments" asp-action="Today" class="nav-link @Active("Appointments","Today")">
                                        <i class="fa fa-calendar-check-o nav-icon"></i>
                                        <p>Hoy <span class="badge badge-primary badge-sm ml-1">HOY</span></p>
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }

                @* Historia clínica — Admin, SuperAdmin, Doctor *@
                @if (canSeeHistoria)
                {
                    <li class="nav-item has-treeview @(Active("MedicalRecords") != "" || Active("Prescriptions") != "" ? "menu-open" : "")">
                        <a href="#" class="nav-link @(Active("MedicalRecords") != "" || Active("Prescriptions") != "" ? "active" : "")">
                            <i class="nav-icon fa fa-file-text-o"></i>
                            <p>Historia clínica <i class="right fa fa-angle-left"></i></p>
                        </a>
                        <ul class="nav nav-treeview">
                            <li class="nav-item">
                                <a asp-controller="MedicalRecords" asp-action="Index" class="nav-link @Active("MedicalRecords")">
                                    <i class="fa fa-stethoscope nav-icon"></i>
                                    <p>Consultas</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Prescriptions" asp-action="Index" class="nav-link @Active("Prescriptions","Index")">
                                    <i class="fa fa-medkit nav-icon"></i>
                                    <p>Recetas</p>
                                </a>
                            </li>
                        </ul>
                    </li>
                }

                @* Inteligencia / Reportes — Admin, SuperAdmin, Billing (+ plan) *@
                @if (canSeeReportes)
                {
                    <li class="nav-header text-uppercase small text-muted">Inteligencia</li>
                    <li class="nav-item has-treeview @(openInteligencia ? "menu-open" : "")">
                        <a href="#" class="nav-link @(openInteligencia ? "active" : "")">
                            <i class="nav-icon fa fa-line-chart"></i>
                            <p>Reportes <i class="right fa fa-angle-left"></i></p>
                        </a>
                        <ul class="nav nav-treeview">
                            <li class="nav-item">
                                <a asp-controller="Reports" asp-action="Appointments" class="nav-link @Active("Reports","Appointments")">
                                    <i class="fa fa-calendar nav-icon"></i><p>Citas</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Reports" asp-action="Patients" class="nav-link @Active("Reports","Patients")">
                                    <i class="fa fa-users nav-icon"></i><p>Pacientes</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Reports" asp-action="Financial" class="nav-link @Active("Reports","Financial")">
                                    <i class="fa fa-money nav-icon"></i><p>Financiero</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Reports" asp-action="Doctors" class="nav-link @Active("Reports","Doctors")">
                                    <i class="fa fa-user-md nav-icon"></i><p>Doctores</p>
                                </a>
                            </li>
                            @if (isAdminLike)
                            {
                                <li class="nav-item">
                                    <a asp-controller="Analytics" asp-action="Index" class="nav-link @Active("Analytics","Index")">
                                        <i class="fa fa-dashboard nav-icon"></i><p>Dashboard ejecutivo</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Analytics" asp-action="Trends" class="nav-link @Active("Analytics","Trends")">
                                        <i class="fa fa-line-chart nav-icon"></i><p>Tendencias</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Analytics" asp-action="Benchmarking" class="nav-link @Active("Analytics","Benchmarking")">
                                        <i class="fa fa-trophy nav-icon"></i><p>Benchmarking</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Analytics" asp-action="Snapshots" class="nav-link @Active("Analytics","Snapshots")">
                                        <i class="fa fa-database nav-icon"></i><p>Snapshots</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Analytics" asp-action="Settings" class="nav-link @Active("Analytics","Settings")">
                                        <i class="fa fa-cog nav-icon"></i><p>Configuración</p>
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }

                @* Facturación y caja — Admin, SuperAdmin, Billing (+ plan) *@
                @if (canSeeFinanzas)
                {
                    <li class="nav-header text-uppercase small text-muted">Facturación y caja</li>
                    <li class="nav-item has-treeview @(openFinanza ? "menu-open" : "")">
                        <a href="#" class="nav-link @(openFinanza ? "active" : "")">
                            <i class="nav-icon fa fa-money"></i>
                            <p>Finanzas <i class="right fa fa-angle-left"></i></p>
                        </a>
                        <ul class="nav nav-treeview">
                            <li class="nav-item">
                                <a asp-controller="BillingInvoices" asp-action="Index" class="nav-link @Active("BillingInvoices")">
                                    <i class="fa fa-circle-o nav-icon"></i><p>Facturas</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Payments" asp-action="Index" class="nav-link @Active("Payments")">
                                    <i class="fa fa-circle-o nav-icon"></i><p>Pagos</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="CashMovements" asp-action="Index" class="nav-link @Active("CashMovements")">
                                    <i class="fa fa-circle-o nav-icon"></i><p>Caja</p>
                                </a>
                            </li>
                            @if (isAdminLike)
                            {
                                <li class="nav-item">
                                    <a asp-controller="EventLogs" asp-action="Index" class="nav-link @Active("EventLogs")">
                                        <i class="fa fa-circle-o nav-icon"></i><p>Eventos del sistema</p>
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }

                @* Contabilidad — Admin, SuperAdmin *@
                @if (canSeeContabilidad)
                {
                    <li class="nav-header text-uppercase small text-muted">Contabilidad</li>
                    <li class="nav-item has-treeview @(openContabilidad ? "menu-open" : "")">
                        <a href="#" class="nav-link @(openContabilidad ? "active" : "")">
                            <i class="nav-icon fa fa-calculator"></i>
                            <p>Contabilidad <i class="right fa fa-angle-left"></i></p>
                        </a>
                        <ul class="nav nav-treeview">
                            <li class="nav-item">
                                <a asp-controller="Ledger" asp-action="Dashboard" class="nav-link @(IsLedgerDashboard ? "active" : "")">
                                    <i class="nav-icon fa fa-tachometer-alt"></i>
                                    <p>Dashboard</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="ChartOfAccounts" asp-action="Index" class="nav-link @Active("ChartOfAccounts","Index")">
                                    <i class="fa fa-circle-o nav-icon"></i><p>Plan de Cuentas</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="ChartOfAccounts" asp-action="Report" class="nav-link @(IsCoaReport ? "active" : "")">
                                    <i class="fa fa-book nav-icon"></i><p>Reporte de Cuentas</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="JournalEntries" asp-action="Index" class="nav-link @Active("JournalEntries")">
                                    <i class="fa fa-circle-o nav-icon"></i><p>Asientos</p>
                                </a>
                            </li>
                            <li class="nav-item has-treeview">
                                <a href="#" class="nav-link @(IsCtrl("Ledger") ? "active" : "")">
                                    <i class="fa fa-circle-o nav-icon"></i><p>Reportes <i class="right fa fa-angle-left"></i></p>
                                </a>
                                <ul class="nav nav-treeview">
                                    <li class="nav-item">
                                        <a asp-controller="Ledger" asp-action="Index" class="nav-link @Active("Ledger","Index")">
                                            <i class="fa fa-circle-o nav-icon"></i><p>Libro Mayor</p>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a asp-controller="Ledger" asp-action="TrialBalance" class="nav-link @Active("Ledger","TrialBalance")">
                                            <i class="fa fa-circle-o nav-icon"></i><p>Bal. Comprobación</p>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a asp-controller="Ledger" asp-action="BalanceSheet" class="nav-link @Active("Ledger","BalanceSheet")">
                                            <i class="fa fa-circle-o nav-icon"></i><p>Balance General</p>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a asp-controller="Ledger" asp-action="IncomeStatement" class="nav-link @Active("Ledger","IncomeStatement")">
                                            <i class="fa fa-circle-o nav-icon"></i><p>Estado Resultados</p>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="FiscalPeriods" asp-action="Index" class="nav-link @Active("FiscalPeriods")">
                                    <i class="fa fa-circle-o nav-icon"></i><p>Períodos Fiscales</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="TaxRates" asp-action="Index" class="nav-link @Active("TaxRates")">
                                    <i class="fa fa-circle-o nav-icon"></i><p>Tasas Impuesto</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="BankAccounts" asp-action="Index" class="nav-link @Active("BankAccounts")">
                                    <i class="fa fa-circle-o nav-icon"></i><p>Cuentas Bancarias</p>
                                </a>
                            </li>
                        </ul>
                    </li>
                }

                @* Seguridad — Admin, SuperAdmin *@
                @if (canSeeSeguridad)
                {
                    <li class="nav-header text-uppercase small text-muted">Seguridad</li>
                    <li class="nav-item has-treeview @(openSeguridad ? "menu-open" : "")">
                        <a href="#" class="nav-link @(openSeguridad ? "active" : "")">
                            <i class="nav-icon fa fa-shield"></i>
                            <p>Seguridad <i class="right fa fa-angle-left"></i></p>
                        </a>
                        <ul class="nav nav-treeview">
                            <li class="nav-item">
                                <a asp-controller="AdminUsers" asp-action="Index" class="nav-link @Active("AdminUsers")">
                                    <i class="fa fa-circle-o nav-icon"></i><p>Usuarios</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="AdminRoles" asp-action="Index" class="nav-link @Active("AdminRoles")">
                                    <i class="fa fa-circle-o nav-icon"></i><p>Roles</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Permissions" asp-action="Index" class="nav-link @Active("Permissions")">
                                    <i class="fa fa-circle-o nav-icon"></i><p>Permisos</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="SecurityAudit" asp-action="Index" class="nav-link @Active("SecurityAudit")">
                                    <i class="fa fa-circle-o nav-icon"></i><p>Auditoría</p>
                                </a>
                            </li>
                        </ul>
                    </li>
                }

                @* Administración — Admin, SuperAdmin *@
                @if (canSeeAdmin)
                {
                    <li class="nav-header text-uppercase small text-muted">Administración</li>
                    @if (featAutomation)
                    {
                        <li class="nav-item">
                            <a asp-controller="Automations" asp-action="Index" class="nav-link @Active("Automations")">
                                <i class="nav-icon fa fa-magic"></i>
                                <p>Automatizaciones</p>
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a asp-area="AI" asp-controller="AIDashboard" asp-action="Index" class="nav-link @((ViewContext.RouteData.Values["area"]?.ToString() == "AI" && string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "AIDashboard", StringComparison.OrdinalIgnoreCase)) ? "active" : "")">
                            <i class="nav-icon fa fa-brain"></i>
                            <p>IA Operativa</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="AI" asp-controller="GrowthEngine" asp-action="Index" class="nav-link @((ViewContext.RouteData.Values["area"]?.ToString() == "AI" && string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "GrowthEngine", StringComparison.OrdinalIgnoreCase)) ? "active" : "")">
                            <i class="nav-icon fa fa-rocket"></i>
                            <p>Motor IA Growth</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="TenantBilling" asp-action="Index" class="nav-link @Active("TenantBilling")">
                            <i class="nav-icon fa fa-credit-card"></i>
                            <p>Mi suscripción</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="ClinicConsole" asp-action="Index" class="nav-link @Active("ClinicConsole")">
                            <i class="nav-icon fa fa-server"></i>
                            <p>Consola clínica</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="SecurityPosture" asp-action="Index" class="nav-link @Active("SecurityPosture")">
                            <i class="nav-icon fa fa-shield"></i>
                            <p>Postura seguridad</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Settings" asp-action="Index" class="nav-link @Active("Settings")">
                            <i class="nav-icon fa fa-cog"></i>
                            <p>Configuración</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="NotificationTemplates" asp-action="Index" class="nav-link @Active("NotificationTemplates")">
                            <i class="nav-icon fa fa-bell"></i>
                            <p>Notificaciones</p>
                        </a>
                    </li>
                }

            </ul>
        </nav>
    </div>
</aside>
