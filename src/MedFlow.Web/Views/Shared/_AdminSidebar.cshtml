@inject MedFlow.Application.Interfaces.ITenantContext TenantContext
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action     = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var http       = ViewContext.HttpContext;

    bool IsCtrl(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase);
    string Active(string c, string? a = null) =>
        IsCtrl(c) && (a == null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase))
            ? "active" : "";

    bool Feat(string key)
    {
        if (User.IsInRole("SuperAdmin")) return true;
        if (http.Items.TryGetValue(key, out var v) && v is bool b) return b;
        return true;
    }
    var featReports    = Feat("PlanFeatureReports");
    var featBilling    = Feat("PlanFeatureBilling");
    var featAutomation = Feat("PlanFeatureAutomation");

    bool isSuperAdmin = User.IsInRole("SuperAdmin");
    bool isAdmin      = User.IsInRole("Admin");
    bool isAdminLike  = isSuperAdmin || isAdmin;
    bool isDoctor     = User.IsInRole("Doctor");
    bool isReception  = User.IsInRole("Reception");
    bool isBilling    = User.IsInRole("Billing");
    bool isStaff      = User.IsInRole("Staff");

    bool canSeePacientes = isAdminLike || isDoctor || isReception || isStaff;
    bool canSeeDoctores  = isAdminLike;
    bool canSeeCitas     = isAdminLike || isDoctor || isReception || isStaff;
    bool canSeeClinica   = canSeePacientes || canSeeDoctores || canSeeCitas;
    bool canSeeHistoria  = isAdminLike || isDoctor;
    bool canSeeReportes  = featReports && (isAdminLike || isBilling);
    bool canSeeFinanzas  = featBilling && (isAdminLike || isBilling);
    bool canSeeSeguridad = isAdminLike;
    bool canSeeAdmin     = isAdminLike;

    bool canSeeContabilidad = isAdminLike || isBilling;
    var openClinica      = IsCtrl("Patients") || IsCtrl("Doctors") || IsCtrl("Appointments");
    var openFinanza      = canSeeFinanzas && (IsCtrl("BillingInvoices") || IsCtrl("Payments") || IsCtrl("CashMovements") || IsCtrl("EventLogs"));
    var openContabilidad = canSeeContabilidad && (IsCtrl("ChartOfAccounts") || IsCtrl("JournalEntries") || IsCtrl("Ledger") || IsCtrl("FiscalPeriods") || IsCtrl("TaxRates") || IsCtrl("BankAccounts"));
    bool IsLedgerDashboard = IsCtrl("Ledger") && string.Equals(action, "Dashboard", StringComparison.OrdinalIgnoreCase);
    bool IsCoaReport = IsCtrl("ChartOfAccounts") && string.Equals(action, "Report", StringComparison.OrdinalIgnoreCase);
    var openSeguridad    = IsCtrl("AdminUsers") || IsCtrl("AdminRoles") || IsCtrl("Permissions") || IsCtrl("SecurityAudit");
    var openInteligencia = canSeeReportes && (IsCtrl("Reports") || IsCtrl("Analytics"));
    var isAIArea         = ViewContext.RouteData.Values["area"]?.ToString() == "AI";
    var openGrowth       = IsCtrl("RevenueRecovery") || IsCtrl("GrowthCrm");
    var canSeeGrowthMenu = isAdminLike || canSeeFinanzas || canSeeReportes || (isReception && canSeePacientes);
}
<aside class="main-sidebar sidebar-dark-primary elevation-4 medflow-sidebar">
    <a asp-controller="Dashboard" asp-action="Index" class="brand-link">
        @if (!string.IsNullOrWhiteSpace(TenantContext.LogoUrl))
        {
            <img src="@TenantContext.LogoUrl" alt="" class="brand-image img-circle elevation-3" style="opacity:.9;object-fit:cover;" />
        }
        else
        {
            <img src="~/lib/adminlte/img/AdminLTELogo.png" alt="" class="brand-image img-circle elevation-3" style="opacity:.9" />
        }
        <span class="brand-text font-weight-light">@(TenantContext.TenantName ?? "MedFlow AI")</span>
    </a>
    <div class="sidebar">
        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column nav-child-indent" data-widget="treeview" role="navigation" data-accordion="false">

                @* Dashboard — todos los roles staff *@
                <li class="nav-item">
                    <a asp-controller="Dashboard" asp-action="Index" class="nav-link @Active("Dashboard")">
                        <i class="nav-icon fa fa-dashboard"></i>
                        <p>Mission Control</p>
                    </a>
                </li>

                @if (canSeeGrowthMenu)
                {
                    <li class="nav-header text-uppercase small text-muted">Crecimiento</li>
                    <li class="nav-item has-treeview @(openGrowth ? "menu-open" : "")">
                        <a href="#" class="nav-link @(openGrowth ? "active" : "")">
                            <i class="nav-icon fa fa-rocket"></i>
                            <p>Crecimiento <i class="right fa fa-angle-left"></i></p>
                        </a>
                        <ul class="nav nav-treeview">
                            @if (canSeeFinanzas || isAdminLike)
                            {
                                <li class="nav-item">
                                    <a asp-controller="RevenueRecovery" asp-action="Index" class="nav-link @Active("RevenueRecovery")">
                                        <i class="fa fa-bolt nav-icon"></i>
                                        <p>Recuperación ingresos</p>
                                    </a>
                                </li>
                            }
                            @if (canSeePacientes)
                            {
                                <li class="nav-item">
                                    <a asp-controller="GrowthCrm" asp-action="Index" class="nav-link @Active("GrowthCrm")">
                                        <i class="fa fa-heart nav-icon"></i>
                                        <p>CRM Crecimiento</p>
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }

                @* Plataforma SaaS — solo SuperAdmin *@
                @if (isSuperAdmin)
                {
                    <li class="nav-header text-uppercase small text-muted">Plataforma SaaS</li>
                    <li class="nav-item">
                        <a asp-area="SuperAdmin" asp-controller="Home" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["area"]?.ToString() == "SuperAdmin" ? "active" : "")">
                            <i class="nav-icon fa fa-building"></i>
                            <p>SuperAdmin</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Ops" asp-controller="Home" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["area"]?.ToString() == "Ops" ? "active" : "")">
                            <i class="nav-icon fa fa-heartbeat"></i>
                            <p>Operaciones</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="SuperAdmin" asp-controller="Tenants" asp-action="Index" class="nav-link">
                            <i class="nav-icon fa fa-hospital-o"></i>
                            <p>Clínicas</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="SuperAdmin" asp-controller="Plans" asp-action="Index" class="nav-link">
                            <i class="nav-icon fa fa-tags"></i>
                            <p>Planes</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="SuperAdmin" asp-controller="Subscriptions" asp-action="Index" class="nav-link">
                            <i class="nav-icon fa fa-credit-card"></i>
                            <p>Suscripciones</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="SuperAdmin" asp-controller="Billing" asp-action="Overview" class="nav-link">
                            <i class="nav-icon fa fa-money"></i>
                            <p>Billing SaaS</p>
                        </a>
                    </li>
                }

                @* Operación clínica — Admin, Doctor, Reception, Staff *@
