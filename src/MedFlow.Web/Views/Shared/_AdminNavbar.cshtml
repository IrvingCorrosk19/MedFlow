@inject MedFlow.Application.Interfaces.ITenantContext TenantContext
<nav class="main-header navbar navbar-expand navbar-white navbar-light border-bottom elevation-1 mf-navbar">
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button" aria-label="Menú"><i class="fa fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-md-inline-block">
            <span class="nav-link text-muted small mb-0 mf-navbar-date">@DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))</span>
        </li>
    </ul>
    <form class="form-inline ml-3 d-none d-lg-flex flex-grow-1 mx-4" onsubmit="return false;">
        <div class="input-group input-group-sm w-100 mf-navbar-search">
            <input type="search" class="form-control form-control-navbar" placeholder="Buscar paciente, cita…" id="globalSearch" disabled title="Próximamente" />
            <div class="input-group-append">
                <button class="btn btn-navbar" type="button" disabled title="Próximamente"><i class="fa fa-search"></i></button>
            </div>
        </div>
    </form>
    <ul class="navbar-nav ml-auto align-items-center">
        <li class="nav-item d-none d-sm-inline-block mr-2">
            <span class="badge badge-light border text-muted small mf-tenant-pill" title="Contexto actual">@(TenantContext.TenantName ?? "MedFlow AI")</span>
        </li>
        <li class="nav-item dropdown d-none d-md-block">
            <a class="nav-link position-relative mf-nav-bell" href="#" data-toggle="dropdown" title="Notificaciones" aria-label="Notificaciones">
                <i class="fa fa-bell-o"></i>
            </a>
            <div class="dropdown-menu dropdown-menu-right p-0 shadow border-0 mf-notif-menu" style="min-width: 280px;">
                <div class="dropdown-header font-weight-bold border-bottom bg-light">Notificaciones</div>
                <div class="p-3 text-muted small">Sin alertas nuevas. Las notificaciones del sistema aparecerán aquí.</div>
            </div>
        </li>
        <partial name="_LoginPartial" />
    </ul>
</nav>
