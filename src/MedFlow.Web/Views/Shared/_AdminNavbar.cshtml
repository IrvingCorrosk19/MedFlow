@inject MedFlow.Application.Interfaces.ITenantContext TenantContext
<nav class="main-header navbar navbar-expand navbar-white navbar-light border-bottom elevation-1 mf-navbar">
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button" aria-label="Menú"><i class="fa fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-md-inline-block">
            <span class="nav-link text-muted small mb-0 mf-navbar-date">@DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))</span>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link btn btn-link py-1 border-0 text-muted" id="mfCmdPaletteBtn" title="Paleta de comandos (Ctrl+K)" aria-label="Abrir paleta de comandos">
                <i class="fa fa-bolt" aria-hidden="true"></i><span class="d-none d-xl-inline small ml-1">Ir a…</span>
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link btn btn-link py-1 border-0 text-muted" id="mfThemeToggle" title="Modo oscuro" aria-label="Alternar modo oscuro" aria-pressed="false">
                <i class="fa fa-moon-o" aria-hidden="true"></i>
            </button>
        </li>
    </ul>
    <form class="form-inline ml-3 d-none d-lg-flex flex-grow-1 mx-4" onsubmit="return false;" style="position:relative">
        <div class="input-group input-group-sm w-100 mf-navbar-search">
            <input type="search" class="form-control form-control-navbar" placeholder="Buscar paciente, factura…"
                   id="globalSearch" autocomplete="off" />
            <div class="input-group-append">
                <button class="btn btn-navbar" type="button" id="globalSearchBtn"><i class="fa fa-search"></i></button>
            </div>
        </div>
        <div id="searchResults" class="shadow bg-white border rounded" style="display:none;position:absolute;top:100%;left:0;right:0;z-index:9999;max-height:320px;overflow-y:auto;"></div>
    </form>
    <ul class="navbar-nav ml-auto align-items-center">
        <li class="nav-item d-none d-sm-inline-block mr-2">
            @{
                var tenantBadgeTitle = TenantContext.TenantName ?? "MedFlow AI";
                if (User?.IsInRole("SuperAdmin") == true && TenantContext.TenantCode != null)
                    tenantBadgeTitle += " — Datos clínicos de esta clínica (cambiar: cabecera X-Tenant-Code o subdominio).";
            }
            <span class="badge badge-light border text-muted small mf-tenant-pill" title="@tenantBadgeTitle">@(TenantContext.TenantName ?? "MedFlow AI")</span>
            @if (User?.IsInRole("SuperAdmin") == true && !string.IsNullOrEmpty(TenantContext.TenantCode))
            {
                <span class="badge badge-secondary font-weight-normal small ml-1 d-none d-xl-inline-block" title="Código del tenant resuelto">@TenantContext.TenantCode</span>
            }
        </li>
        <li class="nav-item dropdown d-none d-md-block" id="navNotifDropdown">
            <a class="nav-link position-relative mf-nav-bell" href="#" data-toggle="dropdown" title="Notificaciones" aria-label="Notificaciones" id="navBellBtn">
                <i class="fa fa-bell-o" id="navBellIcon"></i>
                <span class="badge badge-danger navbar-badge d-none" id="navNotifBadge" style="font-size:9px"></span>
            </a>
            <div class="dropdown-menu dropdown-menu-right p-0 shadow border-0 mf-notif-menu" style="min-width: 300px;">
                <div class="dropdown-header font-weight-bold border-bottom bg-light d-flex justify-content-between align-items-center">
                    <span>Notificaciones</span>
                    <small class="text-muted" id="navNotifTime"></small>
                </div>
                <div id="navNotifList" class="p-3 text-muted small">
                    <i class="fa fa-spinner fa-spin mr-1"></i> Cargando…
                </div>
                <div class="dropdown-divider m-0"></div>
                <a href="/Appointments" class="dropdown-item text-center small py-2">
                    <i class="fa fa-calendar mr-1"></i> Ver todas las citas
                </a>
            </div>
        </li>
        <partial name="_LoginPartial" />
    </ul>
</nav>

<script>
    // Global search
    (function () {
        var input = document.getElementById('globalSearch');
        var resultsBox = document.getElementById('searchResults');
        var timer;

        input.addEventListener('input', function () {
            clearTimeout(timer);
            var q = this.value.trim();
            if (q.length < 2) { resultsBox.style.display = 'none'; return; }
            timer = setTimeout(function () { doSearch(q); }, 250);
        });

        input.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') { resultsBox.style.display = 'none'; input.blur(); }
        });

        document.addEventListener('click', function (e) {
            if (!resultsBox.contains(e.target) && e.target !== input) {
                resultsBox.style.display = 'none';
            }
        });

        function doSearch(q) {
            fetch('/api/search?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (data) {
                    if (!data) return;
                    if (data.results.length === 0) {
                        resultsBox.innerHTML = '<div class="p-3 text-muted small">Sin resultados para "' + escHtml(q) + '"</div>';
                    } else {
                        resultsBox.innerHTML = data.results.map(function (r) {
                            return '<a href="' + r.link + '" class="d-flex align-items-center px-3 py-2 border-bottom text-dark text-decoration-none" style="gap:8px">' +
                                '<i class="' + r.icon + ' fa-fw"></i>' +
                                '<div><div class="small font-weight-bold">' + escHtml(r.title) + '</div>' +
                                '<div class="text-muted" style="font-size:11px">' + escHtml(r.subtitle) + '</div></div>' +
                                '</a>';
                        }).join('');
                    }
                    resultsBox.style.display = 'block';
                })
                .catch(function () { });
        }

        function escHtml(s) {
            return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }
    })();

    // Notifications bell
    (function () {
        var loaded = false;

        function loadNotifications() {
            fetch('/api/nav/notifications', { credentials: 'same-origin' })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (data) {
                    if (!data) return;
                    var badge = document.getElementById('navNotifBadge');
                    var icon = document.getElementById('navBellIcon');
                    var list = document.getElementById('navNotifList');
                    var time = document.getElementById('navNotifTime');

                    if (data.count > 0) {
                        badge.textContent = data.count > 9 ? '9+' : data.count;
                        badge.classList.remove('d-none');
                        icon.className = 'fa fa-bell text-warning';
                    } else {
                        badge.classList.add('d-none');
                        icon.className = 'fa fa-bell-o';
                    }

                    time.textContent = new Date().toLocaleTimeString('es', { hour: '2-digit', minute: '2-digit' });

                    if (data.items.length === 0) {
                        list.innerHTML = '<span class="text-muted"><i class="fa fa-check-circle text-success mr-1"></i>Sin alertas pendientes.</span>';
                    } else {
                        list.innerHTML = data.items.map(function (n) {
                            return '<a href="' + n.link + '" class="d-flex align-items-start py-2 border-bottom text-dark text-decoration-none">' +
                                '<i class="' + n.icon + ' mt-1 mr-2 fa-fw"></i>' +
                                '<span class="small">' + n.text + '</span>' +
                                '</a>';
                        }).join('');
                    }
                })
                .catch(function () { });
        }

        // Load on first bell click
        document.getElementById('navBellBtn').addEventListener('click', function () {
            if (!loaded) { loaded = true; loadNotifications(); }
        });

        // Refresh every 5 minutes
        setInterval(function () { loadNotifications(); }, 5 * 60 * 1000);

        // Auto-load after 3s
        setTimeout(function () { loadNotifications(); }, 3000);
    })();
</script>
