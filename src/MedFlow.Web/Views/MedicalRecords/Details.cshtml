@model MedFlow.Domain.Entities.MedicalRecord

<div class="row mb-3">
    <div class="col-md-8">
        <h2 class="mb-1 text-dark">Consulta @Model.VisitDate.ToString("dd/MM/yyyy HH:mm")</h2>
        <p class="text-muted mb-0 small">
            <span class="mr-3"><i class="fa fa-user-md"></i> @Model.Doctor?.FullName</span>
            <span><i class="fa fa-user"></i> @Model.Patient?.NombreCompleto</span>
        </p>
    </div>
    <div class="col-md-4 text-md-right mt-2 mt-md-0">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm"><i class="fa fa-edit"></i> Editar</a>
        <a asp-action="Patient" asp-route-patientId="@Model.PatientId" class="btn btn-default btn-sm">Historial</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" data-confirm-delete>
            @Html.AntiForgeryToken()
            <input type="hidden" name="patientId" value="@Model.PatientId" />
            <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fa fa-archive"></i> Archivar</button>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-lg-4">
        <div class="card card-outline card-secondary shadow-sm h-100">
            <div class="card-header"><h3 class="card-title mb-0 text-sm">Signos vitales</h3></div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-6 text-muted">PA</dt>
                    <dd class="col-6">@(Model.BloodPressure ?? "—")</dd>
                    <dt class="col-6 text-muted">FC</dt>
                    <dd class="col-6">@(Model.HeartRateBpm?.ToString() ?? "—")</dd>
                    <dt class="col-6 text-muted">T°</dt>
                    <dd class="col-6">@(Model.TemperatureCelsius?.ToString() ?? "—")</dd>
                    <dt class="col-6 text-muted">Peso</dt>
                    <dd class="col-6">@(Model.WeightKg?.ToString() ?? "—") kg</dd>
                    <dt class="col-6 text-muted">Talla</dt>
                    <dd class="col-6">@(Model.HeightCm?.ToString() ?? "—") cm</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card card-outline card-primary shadow-sm mb-3">
            <div class="card-header"><h3 class="card-title mb-0">Motivo y diagnóstico</h3></div>
            <div class="card-body">
                <h6 class="text-muted text-uppercase small">Motivo de consulta</h6>
                <p class="border-left border-primary pl-3">@(string.IsNullOrWhiteSpace(Model.ChiefComplaint) ? "—" : Model.ChiefComplaint)</p>
                <h6 class="text-muted text-uppercase small">Diagnóstico</h6>
                <p class="border-left border-info pl-3 font-weight-medium">@(string.IsNullOrWhiteSpace(Model.Diagnosis) ? "—" : Model.Diagnosis)</p>
            </div>
        </div>
    </div>
</div>

<div class="card card-outline card-light shadow-sm mb-3">
    <div class="card-header"><h3 class="card-title mb-0">Notas clínicas</h3></div>
    <div class="card-body">
        <p class="mb-0" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(Model.ClinicalNotes) ? "—" : Model.ClinicalNotes)</p>
    </div>
</div>

<div class="card card-outline card-light shadow-sm mb-3">
    <div class="card-header"><h3 class="card-title mb-0">Plan de tratamiento</h3></div>
    <div class="card-body">
        <p class="mb-0" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(Model.TreatmentPlan) ? "—" : Model.TreatmentPlan)</p>
    </div>
</div>

<div class="card card-outline card-light shadow-sm mb-3">
    <div class="card-header"><h3 class="card-title mb-0">Observaciones</h3></div>
    <div class="card-body">
        <p class="mb-0" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(Model.Observations) ? "—" : Model.Observations)</p>
    </div>
</div>

<div class="card card-outline card-success shadow-sm mb-3">
    <div class="card-header"><h3 class="card-title mb-0">Receta médica</h3></div>
    <div class="card-body p-0">
        @if (Model.Prescriptions.Any())
        {
            <table class="table table-striped mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Medicamento</th>
                        <th>Dosis</th>
                        <th>Frecuencia</th>
                        <th>Duración</th>
                        <th>Indicaciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rx in Model.Prescriptions)
                    {
                        <tr>
                            <td class="font-weight-medium">@rx.MedicationName</td>
                            <td>@(rx.Dosage ?? "—")</td>
                            <td>@(rx.Frequency ?? "—")</td>
                            <td>@(rx.Duration ?? "—")</td>
                            <td>@(rx.Instructions ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="p-4 text-muted text-center small">Sin medicamentos en esta consulta.</div>
        }
    </div>
</div>

<div class="card card-outline card-dark shadow-sm mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">Adjuntos</h3>
    </div>
    <div class="card-body">
        @if (Model.Attachments.Any())
        {
            <ul class="list-unstyled mb-3">
                @foreach (var a in Model.Attachments.Where(x => x.IsActive))
                {
                    <li class="mb-2">
                        <a href="@a.FilePath" target="_blank" rel="noopener"><i class="fa fa-paperclip"></i> @a.FileName</a>
                        <span class="text-muted small">(@a.UploadedAt.ToLocalTime().ToString("g"))</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted small mb-3">No hay archivos adjuntos.</p>
        }
        <form asp-action="UploadAttachment" asp-route-medicalRecordId="@Model.Id" method="post" enctype="multipart/form-data" class="form-inline">
            @Html.AntiForgeryToken()
            <div class="form-group mr-2">
                <input type="file" name="file" class="form-control-file" required />
            </div>
            <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fa fa-upload"></i> Subir</button>
        </form>
    </div>
</div>

<p class="text-muted small">
    Registro @Model.Id · Creado @Model.CreatedAt.ToLocalTime().ToString("g")
    @if (Model.UpdatedAt.HasValue)
    {
        <span> · Actualizado @Model.UpdatedAt.Value.ToLocalTime().ToString("g")</span>
    }
</p>
