@model MedFlow.Application.Reporting.FinancialReportVm
@using MedFlow.Domain.Enums
@{
    ViewData["Title"] = "Reporte financiero";
    var patients = ViewBag.Patients as SelectList;
    var selPay = ViewBag.PaymentMethod as int?;
}

<div class="card card-outline card-primary shadow-sm mb-3">
    <div class="card-header"><h3 class="card-title mb-0"><i class="fa fa-filter"></i> Filtros</h3></div>
    <div class="card-body">
        <form method="get" class="form-row align-items-end">
            <div class="form-group col-md-2">
                <label class="small text-muted">Desde</label>
                <input type="date" name="from" value="@ViewBag.From" class="form-control form-control-sm" />
            </div>
            <div class="form-group col-md-2">
                <label class="small text-muted">Hasta</label>
                <input type="date" name="to" value="@ViewBag.To" class="form-control form-control-sm" />
            </div>
            <div class="form-group col-md-3">
                <label class="small text-muted">Paciente</label>
                <select name="patientId" class="form-control form-control-sm" asp-items="patients">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="form-group col-md-2">
                <label class="small text-muted">Método pago</label>
                <select name="paymentMethod" class="form-control form-control-sm">
                    <option value="">Todos</option>
                    @foreach (ClinicalPaymentMethod m in Enum.GetValues(typeof(ClinicalPaymentMethod)))
                    {
                        var isSel = selPay.HasValue && selPay.Value == (int)m;
                        if (isSel)
                        {
                            <option value="@((int)m)" selected>@m</option>
                        }
                        else
                        {
                            <option value="@((int)m)">@m</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group col-md-1 mb-0">
                <button type="submit" class="btn btn-primary btn-sm btn-block"><i class="fa fa-search"></i></button>
            </div>
        </form>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-3">
        <div class="small-box bg-navy shadow-sm">
            <div class="inner">
                <h3>@Model.Summary.TotalInvoiced.ToString("N2")</h3>
                <p>Facturado (período)</p>
            </div>
            <div class="icon"><i class="fa fa-file-text-o"></i></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="small-box bg-success shadow-sm">
            <div class="inner">
                <h3>@Model.Summary.TotalCollected.ToString("N2")</h3>
                <p>Cobrado (pagos período)</p>
            </div>
            <div class="icon"><i class="fa fa-money"></i></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="small-box bg-warning shadow-sm">
            <div class="inner">
                <h3>@Model.Summary.Outstanding.ToString("N2")</h3>
                <p>Saldo pendiente global</p>
            </div>
            <div class="icon"><i class="fa fa-balance-scale"></i></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-outline card-secondary h-100">
            <div class="card-body py-2">
                <label class="small text-muted">Por método (período)</label>
                @foreach (var m in Model.TotalsByPaymentMethod)
                {
                    <div class="d-flex justify-content-between small"><span>@m.Name</span><strong>@m.Amount.ToString("N2")</strong></div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card card-outline card-primary shadow-sm mb-3">
    <div class="card-header"><h3 class="card-title mb-0">Facturas</h3></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tblRptInv" class="table table-hover table-striped mb-0 text-nowrap">
                <thead class="thead-light">
                    <tr>
                        <th>Nº</th>
                        <th>Emisión</th>
                        <th>Paciente</th>
                        <th class="text-right">Total</th>
                        <th class="text-right">Saldo</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Invoices)
                    {
                        <tr>
                            <td>@r.InvoiceNumber</td>
                            <td>@r.IssueDate.ToLocalTime().ToString("g")</td>
                            <td>@r.PatientName</td>
                            <td class="text-right">@r.Total.ToString("N2")</td>
                            <td class="text-right">@r.Balance.ToString("N2")</td>
                            <td><span class="badge badge-secondary">@r.StatusLabel</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card card-outline card-success shadow-sm">
    <div class="card-header"><h3 class="card-title mb-0">Pagos</h3></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tblRptPay" class="table table-hover table-striped mb-0 text-nowrap">
                <thead class="thead-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Paciente</th>
                        <th>Factura</th>
                        <th class="text-right">Monto</th>
                        <th>Método</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Payments)
                    {
                        <tr>
                            <td>@r.PaymentDate.ToLocalTime().ToString("g")</td>
                            <td>@r.PatientName</td>
                            <td>@r.InvoiceNumber</td>
                            <td class="text-right font-weight-medium">@r.Amount.ToString("N2")</td>
                            <td>@r.MethodLabel</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#tblRptInv, #tblRptPay').DataTable({
                responsive: true,
                pageLength: 25,
                language: { url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json' }
            });
        });
    </script>
}
