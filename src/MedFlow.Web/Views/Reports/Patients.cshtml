@model MedFlow.Application.Reporting.PatientsReportVm
@{
    ViewData["Title"] = "Reporte de pacientes";
}

<div class="card card-outline card-primary shadow-sm mb-3">
    <div class="card-header"><h3 class="card-title mb-0"><i class="fa fa-filter"></i> Filtros</h3></div>
    <div class="card-body">
        <form id="frmRptPatFilter" method="get" class="form-row align-items-end">
            <div class="form-group col-md-2">
                <label class="small text-muted">Registrados desde</label>
                <input type="date" id="rptPatFrom" name="from" value="@ViewBag.From" class="form-control form-control-sm" />
            </div>
            <div class="form-group col-md-2">
                <label class="small text-muted">Hasta</label>
                <input type="date" id="rptPatTo" name="to" value="@ViewBag.To" class="form-control form-control-sm" />
            </div>
            <div class="form-group col-md-3">
                <div class="custom-control custom-checkbox mt-4">
                    <input type="checkbox" name="includeInactive" value="true" class="custom-control-input" id="chkInact" checked="@(ViewBag.IncludeInactive == true)" />
                    <label class="custom-control-label" for="chkInact">Incluir inactivos</label>
                </div>
            </div>
            <div class="form-group col-md-2 mb-0">
                <button type="submit" class="btn btn-primary btn-sm"><i class="fa fa-search"></i> Aplicar</button>
            </div>
        </form>
    </div>
</div>

<div class="alert alert-info">
    <strong>Nuevos en período:</strong> @Model.NewInPeriod
</div>

<div class="card card-outline card-primary shadow-sm mb-3">
    <div class="card-header"><h3 class="card-title mb-0">Top pacientes por citas</h3></div>
    <div class="card-body">
        @foreach (var t in Model.TopByAppointments)
        {
            <span class="badge badge-info mr-1 mb-1">@t.Name — @t.Count</span>
        }
    </div>
</div>

<div class="card card-outline card-secondary shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">Detalle de pacientes</h3>
        <a href="@Url.Action("ExportPatientsCsv", "Reports", new { from = ViewBag.From, to = ViewBag.To, includeInactive = ViewBag.IncludeInactive })"
           class="btn btn-sm btn-outline-success">
            <i class="fa fa-file-csv"></i> Exportar CSV
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tblRptPat" class="table table-hover table-striped mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Paciente</th>
                        <th>Registro</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Nº citas</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td class="font-weight-medium">@r.Name</td>
                            <td>@r.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td class="text-center">
                                @if (r.IsActive) { <span class="badge badge-success">Activo</span>; }
                                else { <span class="badge badge-secondary">Inactivo</span>; }
                            </td>
                            <td class="text-center"><span class="badge badge-light border">@r.AppointmentCount</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#tblRptPat').DataTable({
                responsive: true,
                pageLength: 25,
                order: [[3, 'desc']],
                language: { url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json' }
            });
            $('#frmRptPatFilter').on('submit', function (e) {
                var f = $('#rptPatFrom').val(), t = $('#rptPatTo').val();
                if (f && t && f > t) {
                    e.preventDefault();
                    alert('La fecha "Desde" no puede ser posterior a "Hasta".');
                }
            });
        });
    </script>
}
