@model MedFlow.Application.Reporting.AppointmentsReportVm
@using MedFlow.Domain.Enums
@{
    ViewData["Title"] = "Reporte de citas";
    var doctors = ViewBag.Doctors as SelectList;
    var specList = ViewBag.SpecialityList as IReadOnlyList<string> ?? Array.Empty<string>();
    var selSpec = ViewBag.SelectedSpeciality as string;
    var selStatus = ViewBag.Status as int?;
}

<div class="card card-outline card-primary shadow-sm mb-3">
    <div class="card-header"><h3 class="card-title mb-0"><i class="fa fa-filter"></i> Filtros</h3></div>
    <div class="card-body">
        <form method="get" class="form-row align-items-end" id="frmRptAptFilter">
            <div class="form-group col-md-2">
                <label class="small text-muted">Desde</label>
                <input type="date" name="from" id="rptAptFrom" value="@ViewBag.From" class="form-control form-control-sm" />
            </div>
            <div class="form-group col-md-2">
                <label class="small text-muted">Hasta</label>
                <input type="date" name="to" id="rptAptTo" value="@ViewBag.To" class="form-control form-control-sm" />
            </div>
            <div class="form-group col-md-3">
                <label class="small text-muted">Doctor</label>
                <select name="doctorId" class="form-control form-control-sm" asp-items="doctors">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="form-group col-md-2">
                <label class="small text-muted">Especialidad</label>
                <select name="speciality" class="form-control form-control-sm">
                    <option value="">Todas</option>
                    @foreach (var sp in specList)
                    {
                        if (string.Equals(selSpec, sp, StringComparison.Ordinal))
                        {
                            <option value="@sp" selected>@sp</option>
                        }
                        else
                        {
                            <option value="@sp">@sp</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group col-md-2">
                <label class="small text-muted">Estado</label>
                <select name="status" class="form-control form-control-sm">
                    <option value="">Todos</option>
                    @foreach (AppointmentStatus s in Enum.GetValues(typeof(AppointmentStatus)))
                    {
                        var isSel = selStatus.HasValue && selStatus.Value == (int)s;
                        if (isSel)
                        {
                            <option value="@((int)s)" selected>@s</option>
                        }
                        else
                        {
                            <option value="@((int)s)">@s</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group col-md-1 mb-0">
                <button type="submit" class="btn btn-primary btn-sm btn-block"><i class="fa fa-search"></i></button>
            </div>
        </form>
    </div>
</div>

<div class="row mb-3">
    @foreach (var t in Model.TotalsByStatus)
    {
        <div class="col-auto mb-2">
            <span class="badge badge-secondary p-2">@t.Name: <strong>@t.Count</strong></span>
        </div>
    }
    <div class="col-auto mb-2"><span class="badge badge-info p-2">Total filas: <strong>@Model.TotalCount</strong></span></div>
</div>

<div class="card card-outline card-secondary shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">Resultados</h3>
        <div class="btn-group btn-group-sm">
            <a href="@Url.Action("ExportAppointmentsPdf", new { from = ViewBag.From, to = ViewBag.To, doctorId = ViewBag.DoctorId, speciality = ViewBag.Speciality, status = ViewBag.Status })"
               class="btn btn-outline-danger" title="Exportar PDF" target="_blank">
                <i class="fa fa-file-pdf-o"></i> PDF
            </a>
            <a href="@Url.Action("ExportAppointmentsCsv", new { from = ViewBag.From, to = ViewBag.To, doctorId = ViewBag.DoctorId, speciality = ViewBag.Speciality, status = ViewBag.Status })"
               class="btn btn-outline-success" title="Exportar CSV">
                <i class="fa fa-file-excel-o"></i> CSV
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tblRptApt" class="table table-hover table-striped mb-0 text-nowrap">
                <thead class="thead-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Paciente</th>
                        <th>Doctor</th>
                        <th>Especialidad</th>
                        <th>Estado</th>
                        <th>Motivo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        var b = r.StatusLabel == nameof(AppointmentStatus.Completed) ? "success"
                            : r.StatusLabel == nameof(AppointmentStatus.Cancelled) ? "danger"
                            : r.StatusLabel == nameof(AppointmentStatus.Confirmed) ? "primary" : "secondary";
                        <tr>
                            <td>@r.Date.ToString("dd/MM/yyyy")</td>
                            <td>@r.Start.ToString(@"hh\:mm")</td>
                            <td>@r.PatientName</td>
                            <td>@r.DoctorName</td>
                            <td>@r.Speciality</td>
                            <td><span class="badge badge-@b">@r.StatusLabel</span></td>
                            <td class="text-truncate" style="max-width: 200px">@(r.Reason ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#tblRptApt').DataTable({
                responsive: true,
                pageLength: 25,
                order: [[0, 'desc']],
                language: { url: '/lib/datatables/es-ES.json' }
            });

            $('#frmRptAptFilter').on('submit', function (e) {
                var from = $('#rptAptFrom').val();
                var to = $('#rptAptTo').val();
                if (from && to && from > to) {
                    e.preventDefault();
                    alert('La fecha "Desde" no puede ser mayor que la fecha "Hasta".');
                    $('#rptAptFrom').focus();
                }
            });
        });
    </script>
}
