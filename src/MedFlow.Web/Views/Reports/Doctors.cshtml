@model MedFlow.Application.Reporting.DoctorsReportVm
@{
    ViewData["Title"] = "Reporte de doctores";
    var doctors = ViewBag.Doctors as SelectList;
}

<div class="card card-outline card-primary shadow-sm mb-3">
    <div class="card-header"><h3 class="card-title mb-0"><i class="fa fa-filter"></i> Filtros</h3></div>
    <div class="card-body">
        <form id="frmRptDocFilter" method="get" class="form-row align-items-end">
            <div class="form-group col-md-2">
                <label class="small text-muted">Desde</label>
                <input type="date" id="rptDocFrom" name="from" value="@ViewBag.From" class="form-control form-control-sm" />
            </div>
            <div class="form-group col-md-2">
                <label class="small text-muted">Hasta</label>
                <input type="date" id="rptDocTo" name="to" value="@ViewBag.To" class="form-control form-control-sm" />
            </div>
            <div class="form-group col-md-4">
                <label class="small text-muted">Doctor</label>
                <select name="doctorId" class="form-control form-control-sm" asp-items="doctors">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="form-group col-md-2 mb-0">
                <button type="submit" class="btn btn-primary btn-sm"><i class="fa fa-search"></i> Aplicar</button>
            </div>
        </form>
    </div>
</div>

<div class="alert alert-light border mb-3">
    <strong>Promedio citas / doctor (en período):</strong> @Model.AvgAppointmentsPerDoctor
</div>

<div class="card card-outline card-secondary shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">Detalle de doctores</h3>
        <div class="btn-group btn-group-sm">
            <a href="@Url.Action("ExportDoctorsPdf", "Reports", new { from = ViewBag.From, to = ViewBag.To, doctorId = ViewBag.DoctorId })"
               class="btn btn-outline-danger" title="Exportar PDF" target="_blank">
                <i class="fa fa-file-pdf-o"></i> PDF
            </a>
            <a href="@Url.Action("ExportDoctorsCsv", "Reports", new { from = ViewBag.From, to = ViewBag.To, doctorId = ViewBag.DoctorId })"
               class="btn btn-outline-success" title="Exportar CSV">
                <i class="fa fa-file-excel-o"></i> CSV
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tblRptDoc" class="table table-hover table-striped mb-0 text-nowrap">
                <thead class="thead-light">
                    <tr>
                        <th>Doctor</th>
                        <th>Especialidad</th>
                        <th class="text-center">Total citas</th>
                        <th class="text-center">Completadas</th>
                        <th class="text-center">Canceladas</th>
                        <th class="text-center">No show</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td class="font-weight-medium">@r.DoctorName</td>
                            <td>@(r.Speciality ?? "—")</td>
                            <td class="text-center"><span class="badge badge-primary">@r.TotalAppointments</span></td>
                            <td class="text-center"><span class="badge badge-success">@r.Completed</span></td>
                            <td class="text-center"><span class="badge badge-danger">@r.Cancelled</span></td>
                            <td class="text-center"><span class="badge badge-warning">@r.NoShow</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#tblRptDoc').DataTable({
                responsive: true,
                pageLength: 25,
                order: [[2, 'desc']],
                language: { url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json' }
            });
            $('#frmRptDocFilter').on('submit', function (e) {
                var f = $('#rptDocFrom').val(), t = $('#rptDocTo').val();
                if (f && t && f > t) {
                    e.preventDefault();
                    alert('La fecha "Desde" no puede ser posterior a "Hasta".');
                }
            });
        });
    </script>
}
