@model MedFlow.Application.Reporting.ExecutiveDashboardVm?
@using System.Linq
@using System.Text.Json
@using MedFlow.Application.Reporting
@using MedFlow.Domain.Enums
@using MedFlow.Web.Models.Ui
@{
    var showFinancial = ViewBag.ShowFinancialDashboard as bool? ?? false;
    string chartJson = "{}";
    List<ExecutiveAlertVm> executiveAlerts = new();
    List<ActivityItemVm> recentActivity = new();
    if (Model != null)
    {
        var j = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
        var chartPayload = new
        {
            appointmentsByDayLabels = Model.AppointmentsByDay.Select(x => x.Date.ToString("dd/MM")).ToList(),
            appointmentsByDayData = Model.AppointmentsByDay.Select(x => x.Count).ToList(),
            statusLabels = Model.AppointmentsByStatus.Select(x => x.Name).ToList(),
            statusData = Model.AppointmentsByStatus.Select(x => x.Count).ToList(),
            revenueLabels = showFinancial ? Model.RevenueByDay.Select(x => x.Date.ToString("dd/MM")).ToList() : new List<string>(),
            revenueData = showFinancial ? Model.RevenueByDay.Select(x => (double)x.Amount).ToList() : new List<double>(),
            monthLabels = Model.NewPatientsByMonth.Select(x => $"{x.Month:00}/{x.Year}").ToList(),
            newPatientsData = Model.NewPatientsByMonth.Select(x => x.Count).ToList(),
            payMethodLabels = showFinancial ? Model.PaymentsByMethod.Select(x => x.Name).ToList() : new List<string>(),
            payMethodData = showFinancial ? Model.PaymentsByMethod.Select(x => (double)x.Amount).ToList() : new List<double>(),
            cancelLabels = Model.CancellationsByDay.Select(x => x.Date.ToString("dd/MM")).ToList(),
            cancelData = Model.CancellationsByDay.Select(x => x.Count).ToList(),
            topSpecLabels = Model.TopSpecialitiesByAppointments.Select(x => x.Name).ToList(),
            topSpecData = Model.TopSpecialitiesByAppointments.Select(x => x.Count).ToList(),
            topDocLabels = Model.TopDoctorsByAppointments.Select(x => x.Name).ToList(),
            topDocData = Model.TopDoctorsByAppointments.Select(x => x.Count).ToList()
        };
        chartJson = JsonSerializer.Serialize(chartPayload, j);

        executiveAlerts = showFinancial
            ? Model.ExecutiveAlerts.ToList()
            : Model.ExecutiveAlerts.Where(a =>
                !a.Message.Contains("factura", StringComparison.OrdinalIgnoreCase) &&
                !a.Message.Contains("saldo", StringComparison.OrdinalIgnoreCase) &&
                !a.Message.Contains("cartera", StringComparison.OrdinalIgnoreCase)).ToList();

        recentActivity = showFinancial
            ? Model.RecentActivity.ToList()
            : Model.RecentActivity.Where(a => !a.IconClass.Contains("money", StringComparison.OrdinalIgnoreCase)).ToList();
    }
}

<div class="mb-3">
    @foreach (var d in new[] { 7, 14, 30, 60, 90 })
    {
        <a asp-action="Index" asp-route-days="@d"
           class="btn btn-sm @(ViewBag.Days == d ? "btn-primary" : "btn-outline-secondary") mr-1">
            @d días
        </a>
    }
</div>

@if (Model == null)
{
    <div class="alert alert-danger">@(ViewData["ErrorMessage"] as string ?? "No se pudieron cargar los datos del dashboard.")</div>
    <p><a asp-action="Index" class="btn btn-primary" asp-route-days="@ViewBag.Days">Reintentar</a></p>
}
else
{
    var aptD = DateTime.Today;
    var aptTodayAll = Url.Action("Index", "Appointments", new { from = aptD, to = aptD });
    var aptTodayScheduled = Url.Action("Index", "Appointments", new { from = aptD, to = aptD, status = (int)AppointmentStatus.Scheduled });
    var aptTodayConfirmed = Url.Action("Index", "Appointments", new { from = aptD, to = aptD, status = (int)AppointmentStatus.Confirmed });
    var aptTodayCancelled = Url.Action("Index", "Appointments", new { from = aptD, to = aptD, status = (int)AppointmentStatus.Cancelled });
    var aptTodayCompleted = Url.Action("Index", "Appointments", new { from = aptD, to = aptD, status = (int)AppointmentStatus.Completed });
    var aptTodayNoShow = Url.Action("Index", "Appointments", new { from = aptD, to = aptD, status = (int)AppointmentStatus.NoShow });
    var patientsInactive = Url.Action("Index", "Patients", new { estadoActivo = false });
    var invoicesPendingPartial = Url.Action("Index", "BillingInvoices", new { status = InvoiceStatus.Pending });
<input type="hidden" id="mfDashboardDays" value="@ViewBag.Days" />
<div class="mf-mission-control mf-premium-dashboard-shell">
<partial name="Components/_MissionControlHeader" model="Model" />
<partial name="Components/_MissionControlCompareStrip" model="Model" />
<partial name="Components/_GrowthAiInsights" model="Model" />

<div class="row mb-3 medflow-dashboard-toolbar mf-xp-sticky-toolbar">
    <div class="col-12 d-flex flex-wrap justify-content-between align-items-center">
        <div class="mb-2 mb-md-0">
            <span class="badge badge-light border text-muted mr-1 mb-1">Cancelación (período): <strong>@Model.CancellationRatePeriod %</strong></span>
            <span class="badge badge-light border text-muted mb-1">Completitud: <strong>@Model.CompletionRatePeriod %</strong></span>
        </div>
        <div class="d-flex flex-wrap align-items-center mr-2 mb-2 mb-md-0" style="gap:12px;">
            <label class="small text-muted mb-0 d-flex align-items-center" title="Recarga la página cada 3 min mientras esta pestaña está visible">
                <input type="checkbox" id="mfMcRefreshToggle" class="mr-1" />
                Auto 3 min
            </label>
            <label class="small text-muted mb-0 d-flex align-items-center" title="Actualiza solo los KPI del hero sin recargar gráficos">
                <input type="checkbox" id="mfMcFetchToggle" class="mr-1" />
                KPIs API
            </label>
        </div>
        <div class="btn-group btn-group-sm">
            <a asp-action="ExportCsv" asp-route-days="@ViewBag.Days" class="btn btn-outline-success" title="Exportar CSV"><i class="fa fa-file-excel-o"></i> CSV</a>
            <button type="button" class="btn btn-outline-danger" onclick="window.print();" title="Imprimir / Guardar como PDF"><i class="fa fa-file-pdf-o"></i> PDF</button>
            <button type="button" class="btn btn-outline-primary" onclick="window.print();"><i class="fa fa-print"></i> Imprimir</button>
        </div>
    </div>
    <div class="col-12"><p class="small text-muted mb-0"><i class="fa fa-info-circle"></i> Los <strong>gráficos</strong> solo se actualizan al <strong>recargar la página</strong> o con <strong>Auto 3 min</strong>. El modo <strong>KPIs API</strong> actualiza el hero superior sin tocar los charts.</p></div>
</div>

<div class="row">
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-calendar", ColorClass = "bg-info", Value = Model.AppointmentKpis.TotalToday.ToString(), Label = "Citas hoy", FooterUrl = aptTodayAll, FooterText = "Ver agenda (hoy)" }' />
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-clock-o", ColorClass = "bg-secondary", Value = Model.AppointmentKpis.PendingToday.ToString(), Label = "Pendientes (agendadas)", FooterUrl = aptTodayScheduled, FooterText = "Filtrar agendadas" }' />
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-check-circle", ColorClass = "bg-primary", Value = Model.AppointmentKpis.ConfirmedToday.ToString(), Label = "Confirmadas hoy", FooterUrl = aptTodayConfirmed, FooterText = "Filtrar confirmadas" }' />
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-ban", ColorClass = "bg-danger", Value = Model.AppointmentKpis.CancelledToday.ToString(), Label = "Canceladas hoy", FooterUrl = aptTodayCancelled, FooterText = "Filtrar canceladas" }' />
</div>
<div class="row">
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-check", ColorClass = "bg-success", Value = Model.AppointmentKpis.CompletedToday.ToString(), Label = "Completadas hoy", FooterUrl = aptTodayCompleted, FooterText = "Filtrar completadas" }' />
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-user-times", ColorClass = "bg-warning", Value = Model.AppointmentKpis.NoShowToday.ToString(), Label = "No show hoy", FooterUrl = aptTodayNoShow, FooterText = "Filtrar no-show" }' />
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-users", ColorClass = "bg-primary", Value = Model.PatientKpis.TotalRegistered.ToString(), Label = "Pacientes registrados", FooterUrl = Url.Action("Index", "Patients"), FooterText = "Ver pacientes" }' />
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-user-plus", ColorClass = "bg-teal", Value = Model.PatientKpis.NewThisMonth.ToString(), Label = "Nuevos este mes", FooterUrl = Url.Action("Index", "Patients"), FooterText = "Ver pacientes" }' />
</div>
<div class="row">
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-stethoscope", ColorClass = "bg-olive", Value = Model.PatientKpis.DistinctAttendedToday.ToString(), Label = "Atendidos hoy (únicos)", FooterUrl = Url.Action("Index", "Patients"), FooterText = "Ver pacientes" }' />
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-user-times", ColorClass = "bg-navy", Value = Model.PatientKpis.InactiveCount.ToString(), Label = "Pacientes inactivos", FooterUrl = patientsInactive, FooterText = "Ver inactivos" }' />
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-user-md", ColorClass = "bg-success", Value = Model.DoctorKpis.ActiveCount.ToString(), Label = "Doctores activos", FooterUrl = Url.Action("Doctors", "Reports"), FooterText = "Reporte doctores" }' />
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-trophy", ColorClass = "bg-warning", Value = Model.DoctorKpis.TopDoctorAppointmentCount.ToString(), Label = "Top doctor (14 d): " + (Model.DoctorKpis.TopDoctorByAppointmentsName ?? "—") }' />
</div>
@if (showFinancial)
{
<div class="row">
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-line-chart", ColorClass = "bg-info", Value = Model.DoctorKpis.TopSpecialityAppointmentCount.ToString(), Label = "Demanda especialidad: " + (Model.DoctorKpis.TopSpecialityName ?? "—") }' />
    @if (Model.FinanceKpis.AvgCollectedPerCompletedAppointmentPeriod is { } avgTicket)
    {
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-calculator", ColorClass = "bg-secondary", Value = avgTicket.ToString("N2"), Label = "Ticket medio cobrado (" + ViewBag.Days + " d)", FooterUrl = Url.Action("Index", "BillingInvoices"), FooterText = "Ver facturas" }' />
    }
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-file-text-o", ColorClass = "bg-navy", Value = Model.FinanceKpis.BillingToday.ToString("N2"), Label = "Facturación hoy", FooterUrl = Url.Action("Index", "BillingInvoices"), FooterText = "Ver facturas" }' />
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-calendar", ColorClass = "bg-olive", Value = Model.FinanceKpis.BillingMonth.ToString("N2"), Label = "Facturación mes", FooterUrl = Url.Action("Index", "BillingInvoices"), FooterText = "Ver facturas" }' />
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-money", ColorClass = "bg-success", Value = Model.FinanceKpis.PaymentsToday.ToString("N2"), Label = "Pagos hoy", FooterUrl = Url.Action("Index", "CashMovements"), FooterText = "Ver caja" }' />
</div>
<div class="row">
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-balance-scale", ColorClass = "bg-warning", Value = Model.FinanceKpis.TotalOutstanding.ToString("N2"), Label = "Saldo pendiente total", FooterUrl = Url.Action("Index", "BillingInvoices"), FooterText = "Ir a facturas" }' />
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-hourglass-half", ColorClass = "bg-danger", Value = Model.FinanceKpis.InvoicesPendingOrPartial.ToString(), Label = "Facturas pendientes / parcial", FooterUrl = invoicesPendingPartial, FooterText = "Filtrar pendientes" }' />
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-check-square", ColorClass = "bg-teal", Value = Model.FinanceKpis.InvoicesPaid.ToString(), Label = "Facturas pagadas", FooterUrl = Url.Action("Index", "BillingInvoices"), FooterText = "Ver facturas" }' />
</div>
}
else
{
<div class="row">
    <partial name="Components/_StatCard" model='new StatCardModel { IconClass = "fa fa-line-chart", ColorClass = "bg-info", Value = Model.DoctorKpis.TopSpecialityAppointmentCount.ToString(), Label = "Demanda especialidad: " + (Model.DoctorKpis.TopSpecialityName ?? "—") }' />
</div>
}

<div class="row">
    <div class="col-lg-6">
        <div class="card card-outline mf-xp-card card-primary shadow-sm">
            <div class="card-header"><h3 class="card-title">Citas por día</h3></div>
            <div class="card-body" style="height:280px"><canvas id="chartAptDay"></canvas></div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card card-outline mf-xp-card card-secondary shadow-sm">
            <div class="card-header"><h3 class="card-title">Citas por estado (período)</h3></div>
            <div class="card-body" style="height:280px"><canvas id="chartAptStatus"></canvas></div>
        </div>
    </div>
    @if (showFinancial)
    {
    <div class="col-lg-6">
        <div class="card card-outline mf-xp-card card-success shadow-sm">
            <div class="card-header"><h3 class="card-title">Ingresos por día (pagos)</h3></div>
            <div class="card-body" style="height:280px"><canvas id="chartRevenue"></canvas></div>
        </div>
    </div>
    }
    <div class="col-lg-6">
        <div class="card card-outline mf-xp-card card-primary shadow-sm">
            <div class="card-header"><h3 class="card-title">Pacientes nuevos por mes (12 meses)</h3></div>
            <div class="card-body" style="height:280px"><canvas id="chartNewPatients"></canvas></div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card card-outline mf-xp-card card-warning shadow-sm">
            <div class="card-header"><h3 class="card-title">Top especialidades</h3></div>
            <div class="card-body" style="height:280px"><canvas id="chartTopSpec"></canvas></div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card card-outline mf-xp-card card-info shadow-sm">
            <div class="card-header"><h3 class="card-title">Top doctores por citas</h3></div>
            <div class="card-body" style="height:280px"><canvas id="chartTopDoc"></canvas></div>
        </div>
    </div>
    @if (showFinancial)
    {
    <div class="col-lg-6">
        <div class="card card-outline mf-xp-card card-dark shadow-sm">
            <div class="card-header"><h3 class="card-title">Pagos por método</h3></div>
            <div class="card-body" style="height:280px"><canvas id="chartPayMethod"></canvas></div>
        </div>
    </div>
    }
    <div class="col-lg-6">
        <div class="card card-outline mf-xp-card card-danger shadow-sm">
            <div class="card-header"><h3 class="card-title">Cancelaciones por día</h3></div>
            <div class="card-body" style="height:280px"><canvas id="chartCancelTrend"></canvas></div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-4">
        <div class="card card-outline mf-xp-card card-warning shadow-sm">
            <div class="card-header"><h3 class="card-title"><i class="fa fa-exclamation-triangle"></i> Alertas ejecutivas</h3></div>
            <ul class="list-group list-group-flush">
                @foreach (var a in executiveAlerts)
                {
                    var cls = a.Severity == "danger" ? "list-group-item-danger" : a.Severity == "warning" ? "list-group-item-warning" : a.Severity == "success" ? "list-group-item-success" : "list-group-item-light";
                    var icon = a.Severity == "danger" ? "fa fa-times-circle text-danger" : a.Severity == "warning" ? "fa fa-exclamation-circle text-warning" : a.Severity == "success" ? "fa fa-check-circle text-success" : "fa fa-info-circle text-muted";
                    <li class="list-group-item small @cls d-flex align-items-start">
                        <i class="@icon mr-2 mt-1 flex-shrink-0"></i>
                        <span>@a.Message</span>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card card-outline mf-xp-card card-secondary shadow-sm">
            <div class="card-header"><h3 class="card-title"><i class="fa fa-bolt"></i> Actividad reciente</h3></div>
            <ul class="list-unstyled mb-0 p-3 pt-0" style="max-height:360px;overflow-y:auto">
                @foreach (var act in recentActivity)
                {
                    <li class="media mb-2 pb-2 border-bottom">
                        <span class="mr-2"><i class="@act.IconClass"></i></span>
                        <div class="media-body small">
                            <div>@act.Text</div>
                            @if (act.Timestamp.HasValue)
                            {
                                <span class="text-muted" style="font-size:.75rem"
                                      data-timestamp="@act.Timestamp.Value.ToUniversalTime().ToString("O")"
                                      title="@act.WhenLabel">@act.WhenLabel</span>
                            }
                            else
                            {
                                <span class="text-muted" style="font-size:.75rem">@act.WhenLabel</span>
                            }
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card card-outline mf-xp-card card-primary shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0"><i class="fa fa-calendar"></i> Próximas citas</h3>
                <a asp-controller="Appointments" asp-action="Index" class="btn btn-sm btn-default">Agenda</a>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-sm table-hover mb-0 medflow-table">
                    <thead class="thead-light"><tr><th>Fecha</th><th>Hora</th><th>Paciente</th><th>Estado</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var u in Model.UpcomingAppointments)
                        {
                            <tr>
                                <td class="text-nowrap">@u.ScheduledDate.ToString("dd/MM")</td>
                                <td>@u.StartTime.ToString(@"hh\:mm")</td>
                                <td>@u.PatientName</td>
                                <td><span class="badge badge-secondary">@u.StatusLabel</span></td>
                                <td class="text-right">
                                    <a asp-controller="Appointments" asp-action="Details" asp-route-id="@u.Id" class="btn btn-xs btn-outline-info">Ver</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

</div>
}

@section Scripts {
    @if (Model != null)
    {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>window.MedFlowDashboardKpiUrl = "@Url.Action("KpiSnapshot", "Dashboard")";</script>
    <script src="~/js/mf-mission-control-refresh.js" asp-append-version="true"></script>
    <script src="~/js/dashboard/executive-dashboard.js" asp-append-version="true"></script>
    <script>
        $(function () {
            try {
                var p = @Html.Raw(chartJson);
                if (window.MedFlowExecutiveDashboard) MedFlowExecutiveDashboard.init(p);
            } catch (e) { console.error(e); }
        });

        // Relative timestamps for Recent Activity
        $(function () {
            $('[data-timestamp]').each(function () {
                var ts = new Date($(this).data('timestamp'));
                var now = new Date();
                var diffMs = now - ts;
                var diffMins = Math.round(diffMs / 60000);
                var diffHours = Math.round(diffMs / 3600000);
                var diffDays = Math.round(diffMs / 86400000);
                var rel = diffMins < 1 ? 'ahora mismo'
                    : diffMins < 60 ? 'hace ' + diffMins + ' min'
                    : diffHours < 24 ? 'hace ' + diffHours + ' h'
                    : diffDays < 7 ? 'hace ' + diffDays + ' días'
                    : ts.toLocaleDateString('es');
                $(this).text(rel);
            });
        });
    </script>
    }
}
