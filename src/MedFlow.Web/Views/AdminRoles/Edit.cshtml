@model MedFlow.Web.ViewModels.RoleFormViewModel
@{
    ViewData["Title"] = "Editar rol";
    ViewData["PageSubtitle"] = Model.Name;
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"" + Url.Action("Index") + "\">Roles</a></li><li class=\"breadcrumb-item active\">Editar</li>";
}

<div class="card card-outline card-primary shadow-sm">
    <div class="card-header"><h3 class="card-title mb-0">Editar rol</h3></div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="form-group">
                <div class="custom-control custom-switch">
                    <input asp-for="IsActive" class="custom-control-input" />
                    <label asp-for="IsActive" class="custom-control-label">Rol activo</label>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-default">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
