@model MedFlow.Web.ViewModels.RoleFormViewModel
@{
    ViewData["Title"] = "Nuevo rol";
    ViewData["PageSubtitle"] = "Definir perfil";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"" + Url.Action("Index") + "\">Roles</a></li><li class=\"breadcrumb-item active\">Nuevo</li>";
}

<div class="card card-outline card-primary shadow-sm">
    <div class="card-header"><h3 class="card-title mb-0">Nuevo rol</h3></div>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-default">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
