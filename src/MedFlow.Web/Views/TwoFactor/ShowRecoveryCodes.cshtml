@{
    var codes = ViewBag.RecoveryCodes as string[] ?? Array.Empty<string>();
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="alert alert-warning">
            <i class="fa fa-exclamation-triangle mr-2"></i>
            <strong>Guarda estos códigos ahora.</strong> No volverán a mostrarse.
            Cada código solo puede usarse una vez.
        </div>

        <div class="card card-outline card-dark shadow-sm mb-4">
            <div class="card-header"><h3 class="card-title mb-0"><i class="fa fa-key mr-2"></i>Códigos de recuperación</h3></div>
            <div class="card-body">
                <div class="row">
                    @foreach (var code in codes)
                    {
                        <div class="col-6 col-md-4 mb-2">
                            <code class="d-block text-center bg-light border rounded px-2 py-1 user-select-all">@code</code>
                        </div>
                    }
                </div>
                <hr />
                <p class="small text-muted mb-0">
                    Guárdalos en un gestor de contraseñas o en un lugar seguro y offline.
                    Si pierdes el acceso a tu autenticador, uno de estos códigos te permitirá entrar.
                </p>
            </div>
        </div>

        <div class="d-flex" style="gap:8px">
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-print mr-1"></i> Imprimir
            </button>
            <a asp-action="Index" class="btn btn-primary btn-sm">
                <i class="fa fa-check mr-1"></i> Listo, los guardé
            </a>
        </div>
    </div>
</div>
