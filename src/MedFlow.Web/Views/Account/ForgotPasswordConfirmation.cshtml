@{
    ViewData["Title"] = "Enlace enviado";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · MedFlow AI</title>
    <link rel="stylesheet" href="~/lib/bootstrap4/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="medflow-login-page">
    <div style="max-width:480px;margin:4rem auto;padding:2rem;">
        <div class="alert alert-success">
            <h5><i class="fa fa-check-circle"></i> Solicitud recibida</h5>
            <p class="mb-0">Si el correo está registrado, recibirás un enlace para restablecer tu contraseña en breve.</p>
        </div>
        @if (TempData["ResetLink"] != null)
        {
            <div class="alert alert-info small">
                <strong>Modo desarrollo:</strong> <a href="@TempData["ResetLink"]">@TempData["ResetLink"]</a>
            </div>
        }
        <a href="/Account/Login" class="btn btn-outline-primary btn-block">Volver al inicio de sesión</a>
    </div>
</body>
</html>
