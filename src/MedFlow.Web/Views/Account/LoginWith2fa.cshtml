@model MedFlow.Web.Models.LoginWith2faViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verificación 2FA — MedFlow AI</title>
    <link rel="stylesheet" href="~/lib/adminlte/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
</head>
<body class="hold-transition login-page">
<div class="login-box">
    <div class="login-logo">
        <strong>MedFlow</strong> AI
    </div>
    <div class="card">
        <div class="card-body login-card-body">
            <p class="login-box-msg">
                <i class="fa fa-shield text-primary mr-1"></i>
                Verificación en dos pasos
            </p>
            <p class="text-center text-muted small">
                Ingresa el código de 6 dígitos de tu aplicación autenticadora.
            </p>

            <form asp-action="LoginWith2fa" asp-route-rememberMe="@ViewBag.RememberMe" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                <div class="input-group mb-3">
                    <input asp-for="TwoFactorCode"
                           class="form-control text-center"
                           placeholder="000000"
                           maxlength="7"
                           autocomplete="one-time-code"
                           inputmode="numeric"
                           autofocus
                           style="font-size:1.6rem;letter-spacing:6px;" />
                    <div class="input-group-append">
                        <div class="input-group-text"><i class="fa fa-mobile"></i></div>
                    </div>
                </div>
                <span asp-validation-for="TwoFactorCode" class="text-danger small d-block mb-2"></span>

                <div class="icheck-primary mb-3">
                    <input asp-for="RememberMachine" type="checkbox" id="rememberMachine" />
                    <label for="rememberMachine">Recordar este dispositivo por 30 días</label>
                </div>

                <div class="row">
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary btn-block">
                            <i class="fa fa-check mr-1"></i> Verificar
                        </button>
                    </div>
                </div>
            </form>

            <p class="mt-3 text-center small text-muted">
                ¿Perdiste el acceso al autenticador?<br />
                <a asp-controller="Account" asp-action="Login">Volver al inicio de sesión</a>
            </p>
        </div>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/adminlte/js/adminlte.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
