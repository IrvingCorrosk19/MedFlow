@{
    ViewData["Title"] = "Contraseña restablecida";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · MedFlow AI</title>
    <link rel="stylesheet" href="~/lib/bootstrap4/css/bootstrap.min.css" />
</head>
<body style="background:#f8fafc;">
    <div style="max-width:480px;margin:4rem auto;padding:2rem;">
        <div class="alert alert-success">
            <h5>Contraseña restablecida</h5>
            <p class="mb-0">Tu contraseña ha sido cambiada correctamente. Ya puedes iniciar sesión.</p>
        </div>
        <a href="/Account/Login" class="btn btn-primary btn-block">Iniciar sesión</a>
    </div>
</body>
</html>
