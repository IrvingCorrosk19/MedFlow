@model MedFlow.Web.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Nueva contraseña";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · MedFlow AI</title>
    <link rel="stylesheet" href="~/lib/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap4/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="medflow-login-page">
    <div class="medflow-login-grid" style="grid-template-columns:1fr;">
        <div class="medflow-login-panel" style="margin:auto;max-width:480px;padding:2rem;">
            <div class="medflow-login-card">
                <div class="medflow-login-brand">
                    <img src="~/img/medflow-mark.svg" width="48" height="48" alt="" />
                    <div class="medflow-login-brand-text"><strong>MedFlow AI</strong><span>Nueva contraseña</span></div>
                </div>
                <p class="medflow-login-title">Restablecer contraseña</p>
                <div asp-validation-summary="ModelOnly" class="mf-validation-summary"></div>
                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />
                    <div class="form-group">
                        <label asp-for="Password" class="small font-weight-bold text-muted">Nueva contraseña</label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                        <small class="form-text text-muted">Mín. 6 caracteres, mayúscula, minúscula y dígito.</small>
                        <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="small font-weight-bold text-muted">Confirmar contraseña</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">Cambiar contraseña</button>
                </form>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
