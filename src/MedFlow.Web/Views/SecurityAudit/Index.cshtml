@model IReadOnlyList<MedFlow.Domain.Entities.AuditLog>
@{
    ViewData["Title"] = "Auditoría";
    ViewData["PageSubtitle"] = "Registro de acciones relevantes";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item active\">Auditoría</li>";
}

<div class="card card-outline card-secondary shadow-sm mb-3">
    <div class="card-header"><h3 class="card-title mb-0"><i class="fa fa-filter mr-2"></i>Filtros</h3></div>
    <div class="card-body">
        <form method="get" class="form-row align-items-end">
            <div class="form-group col-md-2">
                <label class="small text-muted">Desde</label>
                <input type="date" name="from" value="@ViewBag.From" class="form-control form-control-sm" />
            </div>
            <div class="form-group col-md-2">
                <label class="small text-muted">Hasta</label>
                <input type="date" name="to" value="@ViewBag.To" class="form-control form-control-sm" />
            </div>
            <div class="form-group col-md-2">
                <label class="small text-muted">Usuario (Id)</label>
                <input type="text" name="userId" value="@ViewBag.UserId" class="form-control form-control-sm" placeholder="GUID" />
            </div>
            <div class="form-group col-md-2">
                <label class="small text-muted">Módulo</label>
                <input type="text" name="module" value="@ViewBag.Module" class="form-control form-control-sm" placeholder="Patients, Security…" />
            </div>
            <div class="form-group col-md-2">
                <label class="small text-muted">Acción</label>
                <input type="text" name="action" value="@ViewBag.Action" class="form-control form-control-sm" />
            </div>
            <div class="form-group col-md-1">
                <label class="small text-muted">Límite</label>
                <input type="number" name="take" value="@ViewBag.Take" class="form-control form-control-sm" min="50" max="1000" />
            </div>
            <div class="form-group col-md-1 mb-0">
                <button type="submit" class="btn btn-primary btn-sm btn-block"><i class="fa fa-search"></i></button>
            </div>
        </form>
    </div>
</div>

<div class="card card-outline card-primary shadow-sm">
    <div class="card-header"><h3 class="card-title mb-0"><i class="fa fa-history mr-2"></i>Registros</h3></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tblAudit" class="table table-hover table-striped mb-0 text-nowrap">
                <thead class="thead-light">
                    <tr>
                        <th>Fecha (UTC)</th>
                        <th>Usuario</th>
                        <th>Módulo</th>
                        <th>Acción</th>
                        <th>Entidad</th>
                        <th>Descripción</th>
                        <th>IP</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@a.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@(a.UserName ?? a.UserId ?? "—")</td>
                            <td><span class="badge badge-secondary">@a.Module</span></td>
                            <td>@a.Action</td>
                            <td><small>@(a.EntityName ?? "") @(a.EntityId != null ? "#" + a.EntityId : "")</small></td>
                            <td class="text-wrap" style="max-width: 280px;">@(a.Description ?? "—")</td>
                            <td><small>@(a.IpAddress ?? "—")</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#tblAudit').DataTable({
                responsive: true,
                pageLength: 25,
                order: [[0, 'desc']],
                language: { url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json' }
            });
        });
    </script>
}
