{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=medflow;Username=postgres;Password=postgres"
  },
  "Security": {
    "RequireHttps": false,
    "EnableSecurityHeaders": true,
    "CookieSameSite": "Lax",
    "CookieSecure": false
  },
  "Cors": {
    "AllowAnyOrigin": false,
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000", "https://localhost:7001" ],
    "AllowCredentials": false
  },
  "RateLimiting": {
    "Enabled": true,
    "LoginPerMinute": 5,
    "RefreshTokenPerMinute": 10,
    "WebhookPerMinute": 60,
    "ApiPerMinute": 100,
    "OnboardingPerMinute": 5
  },
  "Observability": {
    "CorrelationIdHeader": "X-Correlation-ID",
    "IncludeTraceInErrorResponse": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "TenantResolution": {
    "DefaultTenantCode": "demo",
    "AllowHeaderOverride": true,
    "HostSuffix": ""
  },
  "Onboarding": {
    "Enabled": true,
    "AutoSignInAfterProvision": false
  },
  "Saas": {
    "AllowOperationsWhenPastDue": false,
    "SuspendedTenantAllowedPathPrefixes": [
      "/Dashboard",
      "/Settings",
      "/AdminUsers",
      "/Commercial",
      "/Identity"
    ]
  },
  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": "",
    "DefaultCurrency": "USD"
  },
  "Billing": {
    "Dunning": {
      "GracePeriodDays": 7,
      "MaxRetryAttempts": 3
    }
  },
  "Integrations": {
    "N8n": {
      "WebhookBaseUrl": "",
      "ApiKey": ""
    }
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "MedFlow",
    "Audience": "MedFlow.Mobile",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Resend": {
    "ApiKey": "",
    "FromEmail": "notifications@medflow.ai",
    "FromName": "MedFlow AI"
  }
}
