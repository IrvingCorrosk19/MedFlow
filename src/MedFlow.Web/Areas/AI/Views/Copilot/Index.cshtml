<div class="mf-xp-card mf-xp-card-glass mb-4">
    <div class="p-3 border-bottom" style="border-color:var(--mf-border)!important;">
        <h3 class="mb-1" style="font-family:var(--mf-xp-font-display);font-weight:700;font-size:1.15rem;">
            <i class="fa fa-comments mr-2 text-primary"></i>Copiloto operativo
        </h3>
        <p class="text-muted small mb-0">Respuestas basadas en datos del tenant. Límite de uso aplicado con rate limiting en producción.</p>
    </div>
    <div class="p-4">
        <p class="text-muted small">Ejemplos: “¿Qué pacientes requieren seguimiento?”, “¿Qué citas tienen alto riesgo?”, “¿Qué facturas requieren gestión?”</p>
        <form id="copilotForm" class="mb-3">
            @Html.AntiForgeryToken()
            <div class="input-group input-group-lg shadow-sm" style="border-radius:12px;overflow:hidden;">
                <input type="text" id="copilotQuery" class="form-control border-0" maxlength="500" placeholder="Pregunta operativa…" autocomplete="off" />
                <div class="input-group-append">
                    <button type="submit" class="btn btn-primary px-4" id="copilotSubmitBtn">
                        <span id="copilotSpinner" class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true" style="display:none;"></span>
                        Consultar
                    </button>
                </div>
            </div>
        </form>
        <div id="copilotResult" class="mf-xp-card p-3 mt-2" style="display:none;">
            <h6 class="font-weight-bold mb-2" style="font-family:var(--mf-xp-font-display);">Respuesta</h6>
            <p id="resultSummary" class="mb-2 small"></p>
            <div id="resultItems"></div>
            <div id="resultSuggestions" class="mt-2"></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $('#copilotForm').on('submit', function(e) {
        e.preventDefault();
        var q = $('#copilotQuery').val();
        if (!q || !q.trim() || q.trim().length > 500) { if (q.trim().length > 500) alert('La consulta no puede superar 500 caracteres.'); return; }
        var $btn = $('#copilotSubmitBtn');
        var $spinner = $('#copilotSpinner');
        $btn.prop('disabled', true);
        $spinner.show();
        $.ajax({
            url: '@Url.Action("Query", "Copilot")',
            type: 'POST',
            data: { query: q, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
            success: function(data) {
                $('#resultSummary').text(data.summary);
                var $items = $('#resultItems').empty();
                if (data.items && data.items.length) {
                    var $ul = $('<ul class="list-group"></ul>');
                    data.items.forEach(function(i) {
                        var $li = $('<li class="list-group-item"></li>');
                        var $strong = $('<strong></strong>').text(i.title || '');
                        var $br = $('<br>');
                        var $small = $('<small></small>').text(i.description || '');
                        $li.append($strong, $br, $small);
                        if (i.actionUrl) {
                            var $a = $('<a class="btn btn-xs btn-primary float-right">Ir</a>');
                            $a.attr('href', i.actionUrl);
                            $li.append(' ', $a);
                        }
                        $ul.append($li);
                    });
                    $items.append($ul);
                }
                var $sug = $('#resultSuggestions').empty();
                if (data.suggestions && data.suggestions.length) {
                    $sug.append($('<small>Pruebe: </small>'));
                    data.suggestions.forEach(function(s) {
                        var $btn2 = $('<button type="button" class="btn btn-xs btn-outline-secondary mr-1 copilot-suggestion"></button>').text(s);
                        $sug.append($btn2);
                    });
                }
                $('#copilotResult').show();
                $btn.prop('disabled', false);
                $spinner.hide();
            },
            error: function() {
                $('#resultSummary').text('Error al consultar el copiloto. Intente de nuevo.');
                $('#resultItems').empty();
                $('#resultSuggestions').empty();
                $('#copilotResult').show();
                $btn.prop('disabled', false);
                $spinner.hide();
            }
        });
    });
    $(document).on('click', '.copilot-suggestion', function() {
        $('#copilotQuery').val($(this).text());
    });
</script>
}
