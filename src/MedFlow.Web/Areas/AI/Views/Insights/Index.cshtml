@model IReadOnlyList<AIInsight>
@using MedFlow.Domain.Enums
@{
    var metrics = ViewBag.Metrics as AIInsightDashboardMetrics;
    var canManage = ViewBag.CanManage as bool? ?? false;
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <button type="button" class="close" data-dismiss="alert">&times;</button>@TempData["Success"]
    </div>
}

<div class="card card-outline card-secondary shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="form-inline flex-wrap">
            <label class="mr-2 small">Tipo</label>
            <select name="type" class="form-control form-control-sm mr-2 mb-1">
                <option value="">Todos</option>
                @foreach (AIInsightType t in Enum.GetValues<AIInsightType>())
                { <option value="@((int)t)" selected="@(ViewBag.Type != null && (int)ViewBag.Type == (int)t)">@t</option> }
            </select>
            <label class="mr-2 small">Estado</label>
            <select name="status" class="form-control form-control-sm mr-2 mb-1">
                <option value="">Todos</option>
                @foreach (AIInsightStatus s in Enum.GetValues<AIInsightStatus>())
                { <option value="@((int)s)" selected="@(ViewBag.Status != null && (int)ViewBag.Status == (int)s)">@s</option> }
            </select>
            <label class="mr-2 small">Severidad</label>
            <select name="severity" class="form-control form-control-sm mr-2 mb-1">
                <option value="">Todas</option>
                @foreach (AISeverity sev in Enum.GetValues<AISeverity>())
                { <option value="@((int)sev)" selected="@(ViewBag.Severity != null && (int)ViewBag.Severity == (int)sev)">@sev</option> }
            </select>
            <label class="mr-2 small">Desde</label>
            <input type="date" name="from" value="@(ViewBag.From is DateTime df ? df.ToString("yyyy-MM-dd") : "")" class="form-control form-control-sm mr-2 mb-1" style="max-width:130px" />
            <label class="mr-2 small">Hasta</label>
            <input type="date" name="to" value="@(ViewBag.To is DateTime dt ? dt.ToString("yyyy-MM-dd") : "")" class="form-control form-control-sm mr-2 mb-1" style="max-width:130px" />
            <label class="mr-2 small">Score ≥</label>
            <input type="number" name="minScore" value="@ViewBag.MinScore" min="0" max="100" step="1" placeholder="0" class="form-control form-control-sm mr-2 mb-1" style="max-width:70px" />
            <label class="mr-2 small">Conf ≥</label>
            <input type="number" name="minConfidence" value="@ViewBag.MinConfidence" min="0" max="1" step="0.1" placeholder="0" class="form-control form-control-sm mr-2 mb-1" style="max-width:70px" />
            <label class="mr-2 small">Entidad</label>
            <input type="text" name="entityType" value="@ViewBag.EntityType" placeholder="Appointment" class="form-control form-control-sm mr-2 mb-1" style="max-width:100px" />
            <input type="text" name="entityId" value="@ViewBag.EntityId" placeholder="ID" class="form-control form-control-sm mr-2 mb-1" style="max-width:100px" />
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@(ViewBag.PageSize ?? 50)" />
            <button type="submit" class="btn btn-primary btn-sm mb-1">Filtrar</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex align-items-center">
        <h3 class="card-title mb-0">Listado de Insights</h3>
        <div class="ml-auto">
            <a href="@Url.Action("ExportCsv", new { type = ViewBag.Type, status = ViewBag.Status, severity = ViewBag.Severity, from = (ViewBag.From is DateTime df2 ? df2.ToString("yyyy-MM-dd") : null), to = (ViewBag.To is DateTime dt2 ? dt2.ToString("yyyy-MM-dd") : null), minScore = ViewBag.MinScore, minConfidence = ViewBag.MinConfidence, entityType = ViewBag.EntityType, entityId = ViewBag.EntityId })"
               class="btn btn-outline-success btn-sm">
                <i class="fa fa-file-excel-o"></i> CSV
            </a>
        </div>
    </div>
    <div class="card-body table-responsive p-0">
        <table id="tblInsights" class="table table-sm table-hover mb-0">
            <thead class="thead-light">
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Título</th>
                    <th>Severidad</th>
                    <th>Estado</th>
                    <th>Score</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model)
                {
                <tr>
                    <td class="text-nowrap">@i.GeneratedAt.ToLocalTime().ToString("g")</td>
                    <td><span class="badge badge-secondary">@i.InsightType</span></td>
                    <td>
                        <strong>@i.Title</strong>
                        <br /><small class="text-muted">@(i.Summary.Length > 80 ? i.Summary[..80] + "..." : i.Summary)</small>
                    </td>
                    <td><span class="badge badge-@(i.Severity == AISeverity.Critical ? "danger" : i.Severity == AISeverity.Warning ? "warning" : "info")">@i.Severity</span></td>
                    <td><span class="badge badge-@(i.Status == AIInsightStatus.New ? "primary" : "secondary")">@i.Status</span></td>
                    <td>@(i.Score.HasValue ? i.Score.Value.ToString("F0") : "-")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@i.Id" class="btn btn-xs btn-default">Ver</a>
                        @if (canManage && i.Status == AIInsightStatus.New)
                        {
                        <form asp-action="Acknowledge" asp-route-id="@i.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-xs btn-success">Revisado</button>
                        </form>
                        <form asp-action="Dismiss" asp-route-id="@i.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-xs btn-secondary">Descartar</button>
                        </form>
                        }
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    $(function () {
        $('#tblInsights').DataTable({ order: [[0, 'desc']], pageLength: 25, language: { url: '/lib/datatables/es-ES.json' } });
    });
</script>
}
