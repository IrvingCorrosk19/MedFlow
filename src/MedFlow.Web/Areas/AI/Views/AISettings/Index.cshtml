@model AITenantSettingsDto
<div class="card">
    <div class="card-body">
        <form asp-action="Index" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <div class="form-check">
                    <input asp-for="Enabled" class="form-check-input" />
                    <label asp-for="Enabled" class="form-check-label">IA habilitada</label>
                </div>
            </div>
            <hr />
            <h6>Capacidades</h6>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <div class="form-check">
                        <input asp-for="NoShowEnabled" class="form-check-input" />
                        <label asp-for="NoShowEnabled" class="form-check-label">Riesgo de no-show</label>
                    </div>
                </div>
                <div class="form-group col-md-6">
                    <div class="form-check">
                        <input asp-for="PaymentRiskEnabled" class="form-check-input" />
                        <label asp-for="PaymentRiskEnabled" class="form-check-label">Riesgo de cobro</label>
                    </div>
                </div>
                <div class="form-group col-md-6">
                    <div class="form-check">
                        <input asp-for="RecommendationsEnabled" class="form-check-input" />
                        <label asp-for="RecommendationsEnabled" class="form-check-label">Recomendaciones</label>
                    </div>
                </div>
                <div class="form-group col-md-6">
                    <div class="form-check">
                        <input asp-for="CopilotEnabled" class="form-check-input" />
                        <label asp-for="CopilotEnabled" class="form-check-label">Copiloto operativo</label>
                    </div>
                </div>
            </div>
            <hr />
            <h6>Límites</h6>
            <div class="form-row">
                <div class="form-group col-md-4">
                    <label asp-for="MaxDailyInsights">Máx. insights/día</label>
                    <input asp-for="MaxDailyInsights" class="form-control" type="number" min="1" max="500" />
                </div>
                <div class="form-group col-md-4">
                    <label asp-for="ConfidenceThreshold">Umbral de confianza</label>
                    <input asp-for="ConfidenceThreshold" class="form-control" type="number" step="0.1" min="0" max="1" />
                </div>
            </div>
            <hr />
            <h6>Opciones</h6>
            <div class="form-group">
                <div class="form-check">
                    <input asp-for="ShowExplanations" class="form-check-input" />
                    <label asp-for="ShowExplanations" class="form-check-label">Mostrar explicaciones</label>
                </div>
            </div>
            <div class="form-group">
                <div class="form-check">
                    <input asp-for="AllowOperationalSuggestions" class="form-check-input" />
                    <label asp-for="AllowOperationalSuggestions" class="form-check-label">Permitir sugerencias operativas</label>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
        </form>
    </div>
</div>
