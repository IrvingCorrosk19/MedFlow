@{
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"" + Url.Action("Index", "Tenants") + "\">Clínicas</a></li><li class=\"breadcrumb-item active\">Nueva</li>";
    var plans = ViewBag.Plans as IReadOnlyList<SubscriptionPlanListDto> ?? Array.Empty<SubscriptionPlanListDto>();
}
<div class="card card-primary">
    <div class="card-header"><h3 class="card-title mb-0">Alta de clínica</h3></div>
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label>Nombre</label>
                <input name="name" class="form-control" required />
            </div>
            <div class="form-group">
                <label>Código (slug único)</label>
                <input name="code" class="form-control" required placeholder="mi-clinica" />
            </div>
            <div class="form-group">
                <label>Email contacto</label>
                <input name="email" type="email" class="form-control" />
            </div>
            <div class="form-group">
                <label>Plan inicial</label>
                <select name="subscriptionPlanId" class="form-control" required>
                    @foreach (var p in plans)
                    {
                        <option value="@p.Id">@p.Name — @p.MonthlyPrice @p.Currency / mes</option>
                    }
                </select>
            </div>
            <div class="form-check mb-3">
                <input type="checkbox" name="startWithTrial" value="true" class="form-check-input" id="trial" />
                <label class="form-check-label" for="trial">Iniciar en período de prueba (según días del plan)</label>
            </div>
            <button type="submit" class="btn btn-primary">Crear clínica</button>
            <a asp-action="Index" class="btn btn-default">Cancelar</a>
        </form>
    </div>
</div>
