@using MedFlow.Domain.Entities
@model IReadOnlyList<MedicalRecord>
@{
    ViewData["Title"] = "Mi Historial Médico";
}

<div class="d-flex align-items-center mb-4">
    <h2 class="mb-0"><i class="fa fa-file-medical-alt mr-2"></i>Mi Historial Médico</h2>
</div>

@if (!Model.Any())
{
    <div class="portal-card card text-center py-5">
        <div class="card-body">
            <i class="fa fa-folder-open-o fa-3x text-muted mb-3 d-block"></i>
            <p class="text-muted mb-0">No tienes consultas registradas aún.</p>
        </div>
    </div>
}
else
{
    <div class="row">
        @foreach (var r in Model.OrderByDescending(x => x.VisitDate))
        {
            <div class="col-md-6 col-lg-4 mb-3">
                <div class="portal-card card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <small class="text-muted">
                                <i class="fa fa-calendar mr-1"></i>
                                @r.VisitDate.ToString("dd/MM/yyyy")
                            </small>
                            @if (r.Prescriptions.Any())
                            {
                                <span class="badge badge-success" title="Incluye recetas">
                                    <i class="fa fa-pills mr-1"></i>@r.Prescriptions.Count receta@(r.Prescriptions.Count != 1 ? "s" : "")
                                </span>
                            }
                        </div>
                        <p class="font-weight-bold mb-1 text-dark">
                            <i class="fa fa-user-md mr-1 text-muted"></i>@(r.Doctor?.FullName ?? "—")
                        </p>
                        @if (!string.IsNullOrWhiteSpace(r.Diagnosis))
                        {
                            <p class="small mb-1">
                                <span class="text-muted">Diagnóstico:</span>
                                <span class="text-truncate d-inline-block" style="max-width:180px;" title="@r.Diagnosis">@r.Diagnosis</span>
                            </p>
                        }
                        @if (!string.IsNullOrWhiteSpace(r.ChiefComplaint))
                        {
                            <p class="small text-muted mb-0 text-truncate" title="@r.ChiefComplaint">
                                <i class="fa fa-comment-o mr-1"></i>@r.ChiefComplaint
                            </p>
                        }
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-0">
                        <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-outline-primary btn-sm btn-block">
                            <i class="fa fa-eye mr-1"></i>Ver detalle y recetas
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
