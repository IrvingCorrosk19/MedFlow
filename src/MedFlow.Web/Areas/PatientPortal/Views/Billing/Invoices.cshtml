@model IReadOnlyList<MedFlow.Application.PatientPortal.PatientInvoiceListItemDto>
@{
    ViewData["Title"] = "Mis Facturas";
    var balanceDue = ViewData["BalanceDue"] as decimal? ?? 0;
}
<h2 class="mb-4">Mis Facturas</h2>

@if (balanceDue > 0)
{
    <div class="alert alert-warning mb-4">
        <strong>Saldo pendiente:</strong> @balanceDue.ToString("C")
    </div>
}

@if (!Model.Any())
{
    <div class="portal-card card">
        <div class="card-body portal-empty">
            <i class="fa fa-file-text-o d-block"></i>
            <h5>Sin facturas</h5>
            <p>No tiene facturas registradas.</p>
        </div>
    </div>
}
else
{
    <div class="portal-card card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>N° Factura</th>
                            <th>Fecha</th>
                            <th>Total</th>
                            <th>Pagado</th>
                            <th>Saldo</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model)
                        {
                            <tr>
                                <td>@i.InvoiceNumber</td>
                                <td>@i.IssueDate.ToString("dd/MM/yyyy")</td>
                                <td>@i.TotalAmount.ToString("C")</td>
                                <td>@i.AmountPaid.ToString("C")</td>
                                <td>@i.BalanceDue.ToString("C")</td>
                                <td><span class="badge badge-secondary">@i.Status</span></td>
                                <td><a asp-action="InvoiceDetail" asp-route-id="@i.Id" class="btn btn-sm btn-outline-primary">Ver</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
