@{
    ViewData["Title"] = "Estado de Cuenta";
    var balanceDue = ViewData["BalanceDue"] as decimal? ?? 0;
    var totalPaid = ViewData["TotalPaid"] as decimal? ?? 0;
    var invoices = ViewData["Invoices"] as IReadOnlyList<MedFlow.Application.PatientPortal.PatientInvoiceListItemDto> ?? new List<MedFlow.Application.PatientPortal.PatientInvoiceListItemDto>();
}
<h2 class="mb-4">Estado de Cuenta</h2>

<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="dashboard-card">
            <div class="card-label">Total pendiente</div>
            <div class="card-value">@balanceDue.ToString("C")</div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="dashboard-card">
            <div class="card-label">Total pagado</div>
            <div class="card-value">@totalPaid.ToString("C")</div>
        </div>
    </div>
</div>

@if (balanceDue > 0)
{
    <div class="alert alert-warning mb-4">
        Tiene facturas pendientes. <a asp-action="Invoices" class="alert-link">Ver facturas</a>
    </div>
}

<h5 class="mb-3">Facturas</h5>
@if (!invoices.Any())
{
    <p class="text-muted">No hay facturas.</p>
}
else
{
    <div class="portal-card card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Factura</th>
                        <th>Fecha</th>
                        <th>Total</th>
                        <th>Saldo</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in invoices.Take(10))
                    {
                        <tr>
                            <td>@i.InvoiceNumber</td>
                            <td>@i.IssueDate.ToString("dd/MM/yyyy")</td>
                            <td>@i.TotalAmount.ToString("C")</td>
                            <td>@i.BalanceDue.ToString("C")</td>
                            <td><a asp-action="InvoiceDetail" asp-route-id="@i.Id" class="btn btn-sm btn-outline-primary">Ver</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
