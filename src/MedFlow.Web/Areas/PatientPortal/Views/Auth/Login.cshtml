@model MedFlow.Web.Areas.PatientPortal.Models.PatientLoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portal del Paciente</title>
    <link rel="stylesheet" href="~/lib/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap4/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/patient-portal.css" asp-append-version="true" />
</head>
<body class="patient-portal">
    <a class="skip-link" href="#portal-login-main">Saltar al formulario de acceso</a>
    <main id="portal-login-main" class="portal-login" tabindex="-1">
        <div class="portal-login-card card">
            <div class="card-body">
                <div class="text-center mb-4">
                    <h1 class="h4 font-weight-bold">Portal del Paciente</h1>
                    <p class="text-muted small">Ingrese sus credenciales para acceder</p>
                </div>
                @if (TempData["PortalLoginHint"] is string hint && !string.IsNullOrWhiteSpace(hint))
                {
                    <div class="alert alert-info small" role="alert">@hint</div>
                }
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <form asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div class="form-group">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" class="form-control" placeholder="********" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="form-group form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">Iniciar sesión</button>
                </form>
            </div>
        </div>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap4/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
