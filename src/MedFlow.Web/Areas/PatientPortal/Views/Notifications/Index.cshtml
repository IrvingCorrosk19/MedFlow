@model IReadOnlyList<MedFlow.Application.PatientPortal.PatientNotificationItemDto>
@{
    ViewData["Title"] = "Notificaciones";
    var unreadCount = ViewData["UnreadCount"] as int? ?? 0;
}
<h2 class="mb-4">Notificaciones @(unreadCount > 0 ? $"({unreadCount} sin leer)" : "")</h2>

@if (!Model.Any())
{
    <div class="portal-card card">
        <div class="card-body portal-empty">
            <i class="fa fa-bell-o d-block"></i>
            <h5>Sin notificaciones</h5>
            <p>No tiene notificaciones.</p>
        </div>
    </div>
}
else
{
    <div class="list-group">
        @foreach (var n in Model)
        {
            <div class="list-group-item list-group-item-action @(n.IsRead ? "" : "list-group-item-primary")">
                <div class="d-flex w-100 justify-content-between">
                    <h6 class="mb-1">@n.Title</h6>
                    <small>@n.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                </div>
                @if (!string.IsNullOrEmpty(n.Message))
                {
                    <p class="mb-2">@n.Message</p>
                }
                @if (!n.IsRead)
                {
                    <form asp-action="MarkRead" asp-route-id="@n.Id" asp-route-returnUrl="@Context.Request.Path" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Marcar como leída</button>
                    </form>
                }
            </div>
        }
    </div>
}
